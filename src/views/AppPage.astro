---
import PlayButton from '../components/PlayButton.astro';
import Icon from '../components/Icon.astro';
import Workflow from '../components/Workflow.astro';
import ReportPreview from '../components/ReportPreview.astro';
import Tutorial from '../components/Tutorial.astro';

import Faq from '../components/Faq.astro';
import InstallBlock from '../components/InstallBlock.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const can = lang === 'ko' ? ['휴대폰에서 수신 가능한 무선신호 확인', '시험 시작 이후 새로 관측된 신호 구분', '선택한 신호의 수신 세기 참고', '현장 확인 내용과 메모 기록'] : ['Observe wireless signals receivable by the phone', 'Distinguish newly observed signals after the start', 'Refer to the strength of a selected signal', 'Record on-site checks and notes'];
const limits = lang === 'ko' ? ['모든 스마트 글래스·이어폰·카메라의 발견 보장', '정확한 거리·좌석·소유자 특정', '촬영·녹음 여부 또는 부정행위 확정', '수신 가능한 무선신호를 보내지 않는 기기의 존재 확인'] : ['Guaranteed discovery of all glasses, earphones or cameras', 'An exact distance, seat or device owner', 'Confirmation of recording activity or misconduct', 'Presence of a device that emits no observable wireless signal'];
---
<section class="page-intro container app-intro"><div><h1>{lang === 'ko' ? '시험감독에,\n하나의 단서를 더.' : 'One more clue.\nA better-informed proctor.'}</h1><p class="page-lead">{lang === 'ko' ? '스마트 글래스, 이어폰, 카메라의 수신 가능한 무선신호를 확인하는 시험감독 보조도구. 신호를 살펴보고, 현장에서 확인하고, 기록으로 남깁니다.' : 'A free supporting tool for exam proctors. Observe receivable wireless signals, check the actual environment and keep a record of what you find.'}</p><PlayButton lang={lang} placement="app-intro"/><p class="small-note">{lang === 'ko' ? 'Android 무료 제공 · iOS 개발 중' : 'Android app in Korean · iOS in development · Store availability varies by region'}</p><nav class="app-section-links" aria-label={lang === 'ko' ? '앱 소개 바로가기' : 'Explore the app'}><a class="text-link" href="#how-it-works">{lang === 'ko' ? '사용 흐름' : 'Workflow'}</a><a class="text-link" href="#report">{lang === 'ko' ? '보고서 예시' : 'Report example'}</a><a class="text-link" href="#tutorial">{lang === 'ko' ? '튜토리얼' : 'Tutorial'}</a></nav></div><dl class="product-facts"><div><dt>{lang === 'ko' ? '현재 제공' : 'Available'}</dt><dd>Android</dd></div><div><dt>{lang === 'ko' ? '이용 요금' : 'Price'}</dt><dd>{lang === 'ko' ? '무료' : 'Free'}</dd></div><div><dt>{lang === 'ko' ? '앱 언어' : 'App language'}</dt><dd>{lang === 'ko' ? '한국어' : 'Korean'}</dd></div><div><dt>{lang === 'ko' ? '제품 역할' : 'Role'}</dt><dd>{lang === 'ko' ? '시험감독 보조' : 'Proctoring support'}</dd></div></dl></section>
<section class="section section-soft" id="how-it-works"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '준비부터 멈춤까지,\n명확한 사용 흐름.' : 'From preparation to pause.\nOne clear workflow.'}</h2><p>{lang === 'ko' ? '실제 평가 전에 사용 순서와\n휴대폰의 수신 상태를 확인해 주세요.' : 'Check the workflow and your phone’s\nreception status before a real assessment.'}</p></div><Workflow lang={lang}/></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '할 수 있는 일과,\n판단할 수 없는 일.' : 'What it can show.\nWhat it cannot establish.'}</h2><p>{lang === 'ko' ? '관측 범위를 이해하는 것도\n도구를 잘 사용하는 방법입니다.' : 'Understanding the limits is part\nof using the tool well.'}</p></div><div class="scope-grid"><div><h3>{lang === 'ko' ? '앱이 돕는 일' : 'The app helps you'}</h3><ul>{can.map(item => <li><Icon name="check"/>{item}</li>)}</ul></div><div><h3>{lang === 'ko' ? '앱만으로 판단할 수 없는 것' : 'The app alone cannot establish'}</h3><ul>{limits.map(item => <li><span class="list-dash" aria-hidden="true"></span>{item}</li>)}</ul></div></div><div class="scope-note"><p>{lang === 'ko' ? '기기의 통신 방식과 연결 상태, 휴대폰과 운영체제 조건에 따라 관측 결과가 달라집니다. 새로운 신호는 현장을 확인하는 출발점입니다.' : 'Observations depend on the device’s communication method and connection state, as well as the phone and operating system. A new signal is a starting point for an on-site check.'}</p><a class="text-link" href={path(lang, 'journal', 'what-the-app-can-observe')}>{lang === 'ko' ? '관측 범위에 관한 가이드 읽기' : 'Read the observation guide'}<Icon name="arrow"/></a></div></div></section>
<ReportPreview lang={lang}/>
<Tutorial lang={lang}/>
<Faq lang={lang} full/>
<InstallBlock lang={lang}/>
