---
import PlayButton from '../components/PlayButton.astro';
import Icon from '../components/Icon.astro';
import Workflow from '../components/Workflow.astro';
import ReportPreview from '../components/ReportPreview.astro';
import Tutorial from '../components/Tutorial.astro';

import Faq from '../components/Faq.astro';
import InstallBlock from '../components/InstallBlock.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const can = lang === 'ko' ? ['휴대폰이 수신할 수 있는 Wi-Fi·Bluetooth 신호 확인', '시험 시작 뒤 새로 잡힌 신호 구분 및 진동 알림', '선택한 신호의 수신 세기 변화 확인', '현장 점검 결과·메모 기록 및 PDF 보고서 저장'] : ['Check Wi-Fi and Bluetooth signals your phone can receive', 'Separate new signals after the start with vibration alerts', 'Review signal strength changes for a selected item', 'Log on-site check results and notes, and save a PDF report'];
const limits = lang === 'ko' ? ['모든 스마트안경·이어폰·카메라 탐지 보장', '정확한 거리·좌석·소유자 특정', '촬영·녹음이나 부정행위 여부 단정', '수신 가능한 신호를 내보내지 않는 기기 탐지'] : ['Guaranteed detection of all glasses, earphones or cameras', 'Exact distance, seat or device owner', 'Proof of recording activity or cheating', 'Detection of devices emitting no receivable signal'];
---
<section class="page-intro container app-intro"><div><h1>{lang === 'ko' ? '시험 중 무선신호를\n확인하는 앱' : 'Wireless signal checks\nfor exam proctors'}</h1><p class="page-lead">{lang === 'ko' ? '휴대폰으로 주변 무선신호를 살피는 무료 감독 보조 앱입니다. 시험 시작 뒤 새로 잡힌 신호를 진동 알림으로 바로 알아채고, 현장 점검 결과와 메모를 보고서로 남길 수 있습니다.' : 'A free Android supporting tool for exam proctors. Get vibration alerts for new wireless signals after the exam starts, then log your on-site checks and notes in a report.'}</p><PlayButton lang={lang} placement="app-intro"/><p class="small-note">{lang === 'ko' ? 'Android 12 이상 · 무료 · iOS 개발 중' : 'Android 12 or later · Free · App in Korean · iOS in development · Store availability varies by region'}</p><nav class="app-section-links" aria-label={lang === 'ko' ? '앱 소개 바로가기' : 'Explore the app'}><a class="text-link" href="#how-it-works">{lang === 'ko' ? '사용 흐름' : 'Workflow'}</a><a class="text-link" href="#report">{lang === 'ko' ? '보고서 예시' : 'Report example'}</a><a class="text-link" href="#tutorial">{lang === 'ko' ? '사용법 영상' : 'Tutorial'}</a></nav></div><dl class="product-facts"><div><dt>{lang === 'ko' ? '현재 제공' : 'Available'}</dt><dd>Android</dd></div><div><dt>{lang === 'ko' ? '이용 요금' : 'Price'}</dt><dd>{lang === 'ko' ? '무료' : 'Free'}</dd></div><div><dt>{lang === 'ko' ? '앱 언어' : 'App language'}</dt><dd>{lang === 'ko' ? '한국어' : 'Korean'}</dd></div><div><dt>{lang === 'ko' ? '제품 역할' : 'Role'}</dt><dd>{lang === 'ko' ? '시험감독 보조' : 'Proctoring support'}</dd></div></dl></section>
<section class="section section-soft" id="how-it-works"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '앱 사용 순서' : 'How to use the app'}</h2><p>{lang === 'ko' ? '시험 전에 미리 한 번 눌러 보며 휴대폰에서 신호가 잘 잡히는지 확인해 주세요.' : 'Run through these steps beforehand and verify that your phone receives signals.'}</p></div><Workflow lang={lang}/></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '앱에서 확인할 수 있는 범위' : 'What the app can tell you'}</h2><p>{lang === 'ko' ? '신호가 잡혔다는 사실만으로 기기의 주인이나 사용 목적까지 알 수는 없습니다.' : 'A received signal alone never reveals who owns a device or how it is being used.'}</p></div><div class="scope-grid"><div><h3>{lang === 'ko' ? '확인·기록할 수 있는 것' : 'What you can check and record'}</h3><ul>{can.map(item => <li><Icon name="check"/>{item}</li>)}</ul></div><div><h3>{lang === 'ko' ? '앱만으로 판단할 수 없는 것' : 'The app alone cannot establish'}</h3><ul>{limits.map(item => <li><span class="list-dash" aria-hidden="true"></span>{item}</li>)}</ul></div></div><div class="scope-note"><p>{lang === 'ko' ? '수신 결과는 기기의 통신·연결 상태와 휴대폰 기종, 운영체제에 따라 달라집니다. 새 신호가 잡히면 시험실 상황을 직접 살펴주세요.' : 'Results depend on the device’s protocol and pairing state, as well as your phone and OS. Always check the room in person when a new signal appears.'}</p><a class="text-link" href={path(lang, 'journal', 'what-the-app-can-observe')}>{lang === 'ko' ? '신호를 해석하는 방법' : 'How to interpret signals'}<Icon name="arrow"/></a></div></div></section>
<ReportPreview lang={lang}/>
<Tutorial lang={lang}/>
<Faq lang={lang} full/>
<InstallBlock lang={lang}/>
