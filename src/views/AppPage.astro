---
import PlayButton from '../components/PlayButton.astro';
import Icon from '../components/Icon.astro';
import Workflow from '../components/Workflow.astro';
import ReportPreview from '../components/ReportPreview.astro';
import Tutorial from '../components/Tutorial.astro';

import Faq from '../components/Faq.astro';
import InstallBlock from '../components/InstallBlock.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const can = lang === 'ko' ? ['휴대폰에서 수신 가능한 무선신호 확인', '시험 시작 이후 새로 관측된 신호 구분', '선택한 신호의 수신 세기 참고', '현장 확인 내용과 메모 기록'] : ['Observe wireless signals receivable by the phone', 'Distinguish newly observed signals after the start', 'Refer to the strength of a selected signal', 'Record on-site checks and notes'];
const limits = lang === 'ko' ? ['모든 스마트 글래스·이어폰·카메라의 발견 보장', '정확한 거리·좌석·소유자 특정', '촬영·녹음 여부 또는 부정행위 확정', '수신 가능한 무선신호를 보내지 않는 기기의 존재 확인'] : ['Guaranteed discovery of all glasses, earphones or cameras', 'An exact distance, seat or device owner', 'Confirmation of recording activity or misconduct', 'Presence of a device that emits no observable wireless signal'];
---
<section class="page-intro container app-intro"><div><h1>{lang === 'ko' ? '시험 중 무선신호를\n확인하는 앱' : 'Wireless signal checks\nfor exam proctors'}</h1><p class="page-lead">{lang === 'ko' ? '시험 부정행위 예방을 돕도록, 휴대폰으로 수신 가능한 무선신호를 확인합니다. 시험 시작 전과 달라진 신호를 살펴보고 현장 확인 내용과 메모를 남길 수 있습니다.' : 'Check the wireless signals your phone can receive, review changes from before the exam and record the results of your on-site checks.'}</p><PlayButton lang={lang} placement="app-intro"/><p class="small-note">{lang === 'ko' ? 'Android 12 이상 · 무료 · iOS 개발 중' : 'Android 12 or later · App in Korean · iOS in development · Store availability varies by region'}</p><nav class="app-section-links" aria-label={lang === 'ko' ? '앱 소개 바로가기' : 'Explore the app'}><a class="text-link" href="#how-it-works">{lang === 'ko' ? '사용 흐름' : 'Workflow'}</a><a class="text-link" href="#report">{lang === 'ko' ? '보고서 예시' : 'Report example'}</a><a class="text-link" href="#tutorial">{lang === 'ko' ? '사용법 영상' : 'Tutorial'}</a></nav></div><dl class="product-facts"><div><dt>{lang === 'ko' ? '현재 제공' : 'Available'}</dt><dd>Android</dd></div><div><dt>{lang === 'ko' ? '이용 요금' : 'Price'}</dt><dd>{lang === 'ko' ? '무료' : 'Free'}</dd></div><div><dt>{lang === 'ko' ? '앱 언어' : 'App language'}</dt><dd>{lang === 'ko' ? '한국어' : 'Korean'}</dd></div><div><dt>{lang === 'ko' ? '제품 역할' : 'Role'}</dt><dd>{lang === 'ko' ? '시험감독 보조' : 'Proctoring support'}</dd></div></dl></section>
<section class="section section-soft" id="how-it-works"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '앱 사용 순서' : 'How to use the app'}</h2><p>{lang === 'ko' ? '시험 전에 사용 순서를 익히고 휴대폰이 신호를 수신하는지 확인해 주세요.' : 'Try these steps and check reception on your phone before using it during an exam.'}</p></div><Workflow lang={lang}/></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '앱에서 확인할 수 있는 범위' : 'What the app can tell you'}</h2><p>{lang === 'ko' ? '신호가 보인다는 사실만으로 기기의 소유자나 사용 목적을 알 수는 없습니다.' : 'A received signal does not tell you who owns the device or what it is being used for.'}</p></div><div class="scope-grid"><div><h3>{lang === 'ko' ? '확인·기록할 수 있는 것' : 'What you can check and record'}</h3><ul>{can.map(item => <li><Icon name="check"/>{item}</li>)}</ul></div><div><h3>{lang === 'ko' ? '앱만으로 판단할 수 없는 것' : 'The app alone cannot establish'}</h3><ul>{limits.map(item => <li><span class="list-dash" aria-hidden="true"></span>{item}</li>)}</ul></div></div><div class="scope-note"><p>{lang === 'ko' ? '수신 결과는 기기의 통신 방식과 연결 상태, 휴대폰과 운영체제에 따라 달라집니다. 새 신호가 나타나면 시험실 상황을 직접 확인해 주세요.' : 'Results depend on the device’s communication method and connection state, as well as your phone and operating system. Check the room when a new signal appears.'}</p><a class="text-link" href={path(lang, 'journal', 'what-the-app-can-observe')}>{lang === 'ko' ? '신호를 해석하는 방법' : 'How to interpret signals'}<Icon name="arrow"/></a></div></div></section>
<ReportPreview lang={lang}/>
<Tutorial lang={lang}/>
<Faq lang={lang} full/>
<InstallBlock lang={lang}/>
