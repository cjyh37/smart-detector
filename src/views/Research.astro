---
import Icon from '../components/Icon.astro';
import AssessmentDemo from '../components/AssessmentDemo.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
const hardware = ko ? [
  ['시험실 맞춤형 수신부', '휴대폰의 운영체제 제약을 줄이고 무선신호를 더 안정적으로 살필 전용 수신 하드웨어를 연구합니다.'],
  ['시험 중 연속 기록', '시험 전 기준 신호 대비 변화를 연속 기록하고, 수신이 끊기면 상태와 공백 시간을 표시하도록 설계합니다.'],
  ['감독관 중심 화면', '확인이 필요한 새 신호만 추려 보여주고, 점검 결과와 메모를 한 화면에서 바로 남기도록 설계합니다.'],
  ['시험별 통합 보고서', '수신 이력과 현장 점검 내용을 보고서로 묶고, 여러 시험실의 기록을 본부에서 함께 관리하도록 확장할 계획입니다.'],
] : [
  ['Purpose-built reception', 'Research dedicated receiver hardware that reduces phone OS constraints and observes wireless signals more reliably.'],
  ['Continuous exam logging', 'Log changes against the pre-exam baseline and display status alerts and gap durations whenever reception drops.'],
  ['Proctor-focused screen', 'Highlight only new signals awaiting a check and let proctors log findings and notes in one view.'],
  ['Integrated exam reports', 'Bundle reception logs and on-site checks per exam, with plans to manage multi-room records centrally.'],
];
const steps = ko ? [
  ['과제·루브릭 설정', '교수자가 학습 목표와 평가 기준(루브릭), AI 허용 범위를 정합니다.'],
  ['작업 과정 기록', '작업공간 안에서 학생의 질문, AI 대화, 초안 변화와 수정 이유를 기록합니다.'],
  ['기여 분석·점수 초안', '학생이 AI 제안을 어떻게 검토하고 고쳤는지 분석해 루브릭별 점수 초안과 근거를 제시합니다.'],
  ['짧은 구술 확인', '학생의 수정 내용에서 질문을 뽑아 왜 그렇게 판단했는지 직접 설명하게 합니다.'],
  ['교수자 최종 확정', '과정 요약과 점수 근거, 구술 답변을 함께 살펴보고 최종 성적을 확정합니다.'],
] : [
  ['Set task & rubric', 'The instructor sets learning goals, rubric criteria and permitted AI use.'],
  ['Log the work process', 'Record student prompts, AI chats, draft changes and revision reasons inside the workspace.'],
  ['Draft scores with evidence', 'Analyze how the student critiqued and revised AI output, proposing rubric scores backed by records.'],
  ['Brief oral check', 'Generate questions from the student’s own revisions so they explain their reasoning directly.'],
  ['Instructor review', 'Review the process summary, supporting evidence and oral answers before finalizing grades.'],
];
const outcomes = ko ? [
  ['대화·수정 이력 요약', '학생별 작업을 학습 목표에 맞춰 요약하고 항목별 점수 초안과 근거 기록을 나란히 보여줍니다.'],
  ['검토 필요 지점 표시', '과정 기록과 구술 답변 중 짚어볼 대목을 표시하고 원문을 바로 열어 볼 수 있도록 설계합니다.'],
  ['일관된 기준 적용', '학생마다 다른 작업 과정과 구술 답변을 동일한 루브릭으로 검토합니다. 글쓰기·프로젝트·문제해결 과제를 지원할 계획입니다.'],
] : [
  ['Chat & revision summaries', 'Summarize each student’s work against learning goals alongside draft rubric scores and supporting logs.'],
  ['Flagged review points', 'Highlight parts of the process log and oral answers that need a closer look, with one-click access to source records.'],
  ['Consistent rubric across class', 'Evaluate diverse workflows and oral answers under one course rubric across writing, project and problem-solving tasks.'],
];
const roadmap = ko ? [
  ['구상·연구 준비', '감독관과 교수자에게 꼭 필요한 정보를 정의하고 핵심 기술과 검증 방법을 검토합니다.'],
  ['프로토타입 설계', '전용 수신 기기 시제품과 과정 기록·점수 초안·구술 확인이 이어지는 플랫폼 시제품을 만들 계획입니다.'],
  ['현장 검증', '학교와 시험 기관에서 사용 편의성, 신호 수신 품질, 평가 타당성을 검증할 계획입니다.'],
  ['기관 운영 확장', '다수 기기·수업 관리와 기록 보관 기능을 갖춰 기관용 제품으로 확장하겠습니다.'],
] : [
  ['Concept & research prep', 'Define what proctors and instructors need most, and evaluate core technologies and test methods.'],
  ['Prototype design', 'Build prototypes of the receiver and a platform linking process logs, draft scores and oral checks.'],
  ['Field validation', 'Validate usability, reception quality and assessment validity with schools and exam organizers.'],
  ['Institutional rollout', 'Add multi-device, course and archive management for ongoing institutional deployment.'],
];
---
<section class="vision-hero container">
  <div><h1>{ko ? '시험 감독과\n학습 평가 기술' : 'Exam and learning\nassessment tools'}</h1><p class="page-lead">{ko ? '시험 시간 동안 무선신호 변화를 기록할 전용 디바이스와, 학생이 AI를 활용해 과제를 해결한 과정을 평가할 플랫폼을 준비하고 있습니다.' : 'We are preparing a dedicated receiver to log wireless signal changes during exams, alongside a platform to assess how students reason and revise work with AI.'}</p><div class="button-row"><a class="button button-blue" href="#hardware">{ko ? '전용 디바이스' : 'Dedicated device'}<Icon name="arrow"/></a><a class="text-link" href="#learning-platform">{ko ? '학습 과정 평가 플랫폼' : 'Learning assessment platform'}<Icon name="arrow"/></a></div></div>
  <figure><img src="/assets/research/dedicated-device-concept.png" width="1536" height="1024" fetchpriority="high" alt={ko ? '시험실 책상에 놓인 흰색과 파란색 전용 무선 관측 디바이스의 제품 콘셉트 이미지' : 'Product concept rendering of a white and blue dedicated wireless observation device on an exam-room desk'}/></figure>
</section>
<section class="vision-thesis"><div class="container"><h2>{ko ? '무선기기 확인과\nAI 활용 과제 평가' : 'Checking exam rooms.\nAssessing work done with AI.'}</h2><p>{ko ? '시험장에서는 확인할 기기를 빠르게 짚어내고, 수업에서는 학생이 스스로 이해하고 판단한 부분을 가려내야 합니다. 이 두 현장을 돕는 하드웨어와 소프트웨어를 연구합니다.' : 'Exam rooms need clear leads on devices to check; classrooms need visibility into what students understood and solved themselves. We research hardware and software for both settings.'}</p></div></section>
<section class="section" id="hardware"><div class="container">
  <div class="hardware-heading"><h2>{ko ? '시험실에 설치하는\n전용 디바이스' : 'Dedicated hardware\nfor exam rooms'}</h2><p>{ko ? '시험 시간 내내 무선신호 변화를 기록하고 감독관이 확인할 대상을 빠르게 찾도록 돕는 것이 목표입니다. 기준 측정부터 현장 메모, 보고서까지 시험 운영 흐름에 맞춰 설계할 계획입니다.' : 'Our goal is to log wireless signal changes throughout an exam and help proctors spot items to check quickly, connecting baseline scans, room notes and reports in one flow.'}</p></div>
  <dl class="hardware-specs">{hardware.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
  <div class="hardware-flow"><p>{ko ? '전용 디바이스 사용 흐름(계획)' : 'Planned device workflow'}</p><ol>{(ko ? ['기준 측정', '연속 관측', '현장 확인', '보고서'] : ['Baseline', 'Observation', 'On-site check', 'Report']).map((item, index) => <li>{item}{index < 3 && <Icon name="arrow"/>}</li>)}</ol></div>
</div></section>
<section class="learning-section" id="learning-platform"><div class="container">
  <div class="section-heading"><h2>{ko ? 'AI를 쓰는 과정에서\n학생은 무엇을 배웠을까요?' : 'What did the student learn\nwhile working with AI?'}</h2><p>{ko ? '학생의 AI 대화와 초안 수정 과정을 기록해 고유한 기여를 평가하는 플랫폼을 구상하고 있습니다. 루브릭 기반 점수 초안과 짧은 구술 확인으로 교수자의 채점 부담을 줄이는 것이 목표입니다.' : 'We are designing a platform that logs AI chats and draft revisions to assess each student’s own contribution, using rubric score drafts and brief oral checks to cut grading load.'}</p></div>
  <AssessmentDemo lang={lang}/>
</div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{ko ? '과제에서 최종 평가까지' : 'From assignment to final assessment'}</h2><p>{ko ? '최종 제출물뿐 아니라 AI 제안을 검토하고 고친 판단 과정을 함께 살피도록 계획한 흐름입니다.' : 'Planned workflow for evaluating not just final submissions, but how students critiqued and revised AI suggestions.'}</p></div><ol class="learning-steps">{steps.map(([title, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
<section class="section faculty-section"><div class="container faculty-layout"><div class="faculty-intro"><h2>{ko ? '수강생이 많아도\n검토할 내용을 빠르게' : 'Less manual review\nin large classes'}</h2><p>{ko ? '수십 명의 AI 대화와 수정 이력을 일일이 읽지 않아도 되도록 요약과 점수 초안을 먼저 제시하고, 교수자가 확인이 필요한 지점만 짚어 최종 성적을 확정하도록 설계할 계획입니다.' : 'Instead of reading dozens of full AI chat logs from scratch, instructors get summaries and draft scores first, reviewing flagged points before finalizing grades.'}</p></div><dl class="faculty-outcomes">{outcomes.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{ko ? '개발 단계' : 'Development plans'}</h2><p>{ko ? '두 제품 모두 현재 구상·연구 준비 단계에 있습니다.' : 'Both products are currently at the concept and research preparation stage.'}</p></div><ol class="vision-roadmap">{roadmap.map(([title, text], index) => <li><div class="roadmap-position"><span>{String(index + 1).padStart(2, '0')}</span>{index === 0 && <strong>{ko ? '현재 단계' : 'Current stage'}</strong>}</div><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
<section class="section vision-join"><div class="container"><div><h2>{ko ? '제품 개발에\n함께할 파트너를 찾습니다.' : 'Work with us\non these products'}</h2><p>{ko ? '시험 운영이나 수업 평가 현장의 경험을 들려주세요. 무선 하드웨어·AI 연구자, 기관 공급 파트너, 투자자의 문의도 환영합니다.' : 'We would like to hear from schools about exam procedures and classroom assessment. We also welcome researchers, companies and investors interested in wireless hardware, AI or supplying institutions.'}</p></div><div class="vision-contact-list"><a href={path(lang, 'contact') + '?type=institution'}>{ko ? '학교·기관 활용 논의' : 'Schools & institutional use'}<Icon name="arrow"/></a><a href={path(lang, 'contact') + '?type=partnership'}>{ko ? '기술·연구·사업 제휴' : 'Technology & research partnerships'}<Icon name="arrow"/></a><a href={path(lang, 'contact') + '?type=investment'}>{ko ? '투자 문의' : 'Investment inquiries'}<Icon name="arrow"/></a></div></div></section>
