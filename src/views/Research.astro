---
import Icon from '../components/Icon.astro';
import AssessmentDemo from '../components/AssessmentDemo.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
const hardware = ko ? [
  ['시험실에 맞는 수신부', '시험실에서 사용할 무선 수신부를 연구합니다. 휴대폰 앱에서 확인하던 신호를 전용 장비로 더 안정적으로 살피는 것이 목표입니다.'],
  ['시험 중 연속 기록', '시험 시작 전 신호를 기준으로 시험 중 변화를 기록합니다. 수신이 중단되면 감독관이 알 수 있도록 상태와 시간을 표시할 계획입니다.'],
  ['감독관을 위한 화면', '새로 나타난 신호와 확인이 필요한 항목을 모아 보여줍니다. 신호를 확인한 결과와 메모도 같은 화면에서 남기도록 설계합니다.'],
  ['시험별 보고서', '시험별 수신 기록과 감독관의 확인 내용을 보고서로 정리합니다. 기관이 여러 시험실의 기록을 관리할 수 있도록 확장할 계획입니다.'],
] : [
  ['Purpose-built reception', 'Research a receiver for exam rooms, with the goal of observing wireless signals more reliably than a phone app.'],
  ['Recording throughout the exam', 'Record changes against the pre-exam baseline. Show proctors when reception stops and how long the gap lasts.'],
  ['A view for proctors', 'Bring new signals and items awaiting a check into one view, with space to record findings and notes.'],
  ['Reports for each exam', 'Combine reception logs and proctor findings in an exam report. We plan to support institutions managing records from multiple rooms.'],
];
const steps = ko ? [
  ['과제와 평가 기준 설정', '교수자가 학습 목표와 평가 기준(루브릭)을 정하고, 과제에서 AI를 어디까지 쓸 수 있는지 안내합니다.'],
  ['과정 자동 기록', '과제 작업공간에서 학생의 질문과 AI 대화, 초안이 바뀐 과정과 수정 이유를 기록합니다.'],
  ['학생의 기여와 점수 초안', '학생이 AI의 제안을 어떻게 검토하고 고쳤는지 분석합니다. 학생이 더한 내용을 평가 기준에 따라 점수 초안과 근거로 정리합니다.'],
  ['짧은 구술 확인', '학생이 고친 내용에서 질문을 만들어, 왜 그렇게 판단했는지 직접 설명하게 합니다.'],
  ['교수자 검토·확정', '교수자가 과정 요약과 점수 근거, 구술 답변을 확인한 뒤 최종 평가를 확정합니다.'],
] : [
  ['Set the task & rubric', 'The instructor defines learning goals, assessment criteria and the permitted role of AI.'],
  ['Record the process', 'Record the student’s questions, AI conversations, draft versions and reasons for revising them in the assignment workspace.'],
  ['Suggest scores with evidence', 'Identify how the student evaluated and changed AI suggestions. Propose rubric scores with the supporting work attached.'],
  ['Run a brief oral check', 'Ask about the student’s recorded choices and revisions so they can explain their reasoning.'],
  ['Review & finalize', 'The instructor reviews the process summary, score evidence and oral responses together before finalizing the assessment.'],
];
const outcomes = ko ? [
  ['대화와 수정 이력 요약', '학생별 작업 내용을 학습 목표에 맞춰 요약하고, 평가 항목별 점수 초안과 근거를 함께 보여줍니다.'],
  ['추가로 확인할 부분 표시', '과정 기록과 구술 답변 중 더 살펴볼 부분을 표시합니다. 교수자가 해당 기록을 바로 열어 확인할 수 있도록 설계합니다.'],
  ['수업 공통 기준 적용', '학생마다 다른 작업 과정과 구술 답변을 같은 평가 기준으로 검토합니다. 글쓰기와 프로젝트, 문제해결 과제에 적용할 계획입니다.'],
] : [
  ['Summaries of conversations and revisions', 'Summarize each student’s work against the learning goals, with suggested rubric scores and the records supporting them.'],
  ['Points that need a closer look', 'Flag parts of the process record and oral responses that need clarification, with direct access to the relevant work.'],
  ['One rubric across the class', 'Review each student’s work and oral responses against the same course criteria. We plan to support writing, projects and problem-solving assignments.'],
];
const roadmap = ko ? [
  ['기획·연구 준비', '시험 감독관과 교수자가 어떤 정보를 필요로 하는지 정리하고, 필요한 기술과 검증 방법을 검토합니다.'],
  ['프로토타입 설계', '전용 수신 디바이스의 시제품과, 과정 기록부터 점수 초안·구술 확인까지 동작하는 플랫폼을 만들 계획입니다.'],
  ['시험실·수업 검증', '학교와 기관에서 사용 편의성, 신호 수신 품질, 평가 결과의 타당성을 확인할 계획입니다.'],
  ['기관 운영으로 확장', '여러 기기와 수업을 관리하고 기록을 보관하는 기능을 갖춰, 기관이 계속 사용할 수 있는 제품으로 발전시키겠습니다.'],
] : [
  ['Concept & research preparation', 'Identify the information proctors and instructors need, then assess the technology and how to test it.'],
  ['Prototype design', 'Build a receiver prototype and a working platform flow from process recording to suggested scores and oral checks.'],
  ['Room & classroom validation', 'Test usability, reception quality and assessment validity with schools and institutions under their operating conditions.'],
  ['Institutional operation', 'Add the device, course and record management that institutions need for continued use.'],
];
---
<section class="vision-hero container">
  <div><h1>{ko ? '시험 감독과 학습 평가에\n필요한 도구를 만듭니다.' : 'Tools for proctors\nand instructors'}</h1><p class="page-lead">{ko ? '시험실에 두고 무선신호를 살피는 전용 디바이스와, 학생이 AI를 쓰며 어떻게 생각하고 수정했는지 평가하는 플랫폼을 준비하고 있습니다. 학교와 기관이 실제 운영에 쓸 수 있는 제품으로 만들겠습니다.' : 'We are planning a dedicated wireless receiver for exam rooms and a platform that assesses how students reason and revise their work with AI. Both are intended for everyday use in schools and institutions.'}</p><div class="button-row"><a class="button button-blue" href="#hardware">{ko ? '전용 디바이스' : 'Dedicated device'}<Icon name="arrow"/></a><a class="text-link" href="#learning-platform">{ko ? '학습 과정 평가 플랫폼' : 'Learning assessment platform'}<Icon name="arrow"/></a></div></div>
  <figure><img src="/assets/research/dedicated-device-concept.png" width="1536" height="1024" fetchpriority="high" alt={ko ? '시험실 책상에 놓인 흰색과 파란색 전용 무선 관측 디바이스의 제품 콘셉트 이미지' : 'Product concept rendering of a white and blue dedicated wireless observation device on an exam-room desk'}/><figcaption>{ko ? '전용 디바이스 콘셉트 이미지' : 'Dedicated device concept rendering'}</figcaption></figure>
</section>
<section class="vision-thesis"><div class="container"><h2>{ko ? '무선기기 확인과\nAI 활용 과제 평가' : 'Checking exam rooms.\nAssessing work done with AI.'}</h2><p>{ko ? '감독관은 시험실에서 확인이 필요한 기기를 찾아야 하고, 교수자는 학생이 무엇을 직접 이해하고 해결했는지 알아야 합니다. 이 두 업무를 돕는 하드웨어와 소프트웨어를 연구하겠습니다.' : 'Proctors need to identify devices that warrant a check. Instructors need to understand what a student has learned and contributed. Our hardware and software plans address these two tasks.'}</p></div></section>
<section class="section" id="hardware"><div class="container">
  <div class="hardware-heading"><h2>{ko ? '시험실에 설치하는\n전용 디바이스' : 'Dedicated hardware\nfor exam rooms'}</h2><p>{ko ? '시험 시간 동안 무선신호의 변화를 계속 기록하고, 감독관이 확인할 신호를 쉽게 찾게 하는 것이 목표입니다. 기준 측정부터 확인 메모와 보고서까지, 시험 운영에 필요한 기능을 함께 설계하겠습니다.' : 'The goal is to record wireless signal changes throughout an exam and help proctors find the signals that need checking. We plan to design reception, on-site notes and reporting around the way exams are run.'}</p></div>
  <dl class="hardware-specs">{hardware.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
  <div class="hardware-flow"><p>{ko ? '전용 디바이스의 사용 순서' : 'Planned device workflow'}</p><ol>{(ko ? ['기준 측정', '연속 관측', '현장 확인', '보고서'] : ['Baseline', 'Observation', 'On-site check', 'Report']).map((item, index) => <li>{item}{index < 3 && <Icon name="arrow"/>}</li>)}</ol></div>
</div></section>
<section class="learning-section" id="learning-platform"><div class="container">
  <div class="section-heading"><h2>{ko ? 'AI를 쓰는 과정에서\n학생은 무엇을 배웠을까요?' : 'What did the student learn\nwhile working with AI?'}</h2><p>{ko ? '학습 과정 평가 플랫폼은 학생의 AI 대화와 초안, 수정 이유를 자동으로 기록하고 학생이 직접 기여한 내용을 평가하는 제품입니다. 점수 초안을 만들고 짧은 구술로 이해를 확인해, 교수자의 검토 부담을 줄이는 방식으로 개발할 계획입니다.' : 'We plan to build a learning assessment platform that records AI conversations, drafts and revision choices, then evaluates the student’s own contribution. Suggested scores and short oral checks would help instructors assess learning with less manual review.'}</p></div>
  <AssessmentDemo lang={lang}/>
</div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{ko ? '과제에서 최종 평가까지' : 'From assignment to final assessment'}</h2><p>{ko ? '최종 제출물과 함께 학생이 어떤 판단을 거쳐 작업을 고쳤는지 평가합니다. 아래는 플랫폼에서 계획하고 있는 사용 순서입니다.' : 'Assess the decisions and revisions behind the submitted work. This is the workflow we are planning for the platform.'}</p></div><ol class="learning-steps">{steps.map(([title, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
<section class="section faculty-section"><div class="container faculty-layout"><div class="faculty-intro"><h2>{ko ? '수강생이 많아도\n검토할 내용을 빠르게' : 'Less manual review\nin large classes'}</h2><p>{ko ? '학생마다 AI 대화와 수정 이력을 처음부터 읽는 부담을 줄이려 합니다. 플랫폼이 요약과 점수 초안을 준비하면, 교수자는 추가 확인이 필요한 부분을 살펴보고 최종 평가를 내리는 방식입니다.' : 'Reading every student’s AI conversations and draft history takes time. We want the platform to prepare summaries and suggested scores so instructors can review the parts that need attention and make the final assessment.'}</p></div><dl class="faculty-outcomes">{outcomes.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{ko ? '개발 계획' : 'Development plans'}</h2><p>{ko ? '현재는 두 제품의 사용 방식과 연구 과제를 정리하는 단계입니다.' : 'Both products are currently at the concept and research preparation stage.'}</p></div><ol class="vision-roadmap">{roadmap.map(([title, text], index) => <li><div class="roadmap-position"><span>{String(index + 1).padStart(2, '0')}</span>{index === 0 && <strong>{ko ? '현재 단계' : 'Current stage'}</strong>}</div><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
<section class="section vision-join"><div class="container"><div><h2>{ko ? '제품 개발에\n함께할 파트너를 찾습니다.' : 'Work with us\non these products'}</h2><p>{ko ? '학교의 시험 운영이나 수업 평가 경험을 들려주세요. 무선기기·AI 기술 개발, 기관 공급을 함께할 기업과 연구자, 투자자의 문의도 받고 있습니다.' : 'We would like to hear from schools about exam procedures and classroom assessment. We also welcome researchers, companies and investors interested in wireless hardware, AI or supplying institutions.'}</p></div><div class="vision-contact-list"><a href={path(lang, 'contact') + '?type=institution'}>{ko ? '학교·기관 활용 논의' : 'Schools & institutional use'}<Icon name="arrow"/></a><a href={path(lang, 'contact') + '?type=partnership'}>{ko ? '기술·연구·사업 제휴' : 'Technology & research partnerships'}<Icon name="arrow"/></a><a href={path(lang, 'contact') + '?type=investment'}>{ko ? '투자 문의' : 'Investment inquiries'}<Icon name="arrow"/></a></div></div></section>
