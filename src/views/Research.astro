---
import Icon from '../components/Icon.astro';
import AssessmentDemo from '../components/AssessmentDemo.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
const hardware = ko ? [
  ['전용 수신 구조', '시험실 환경에 맞는 무선 수신 구성을 연구합니다. 휴대폰 앱에서 시작한 관측을 목적에 맞춘 하드웨어로 확장합니다.'],
  ['시험 시간 동안의 관측', '시작 전 기준과 시험 중 변화를 이어서 살피도록 설계합니다. 관측 상태와 중단 구간도 운영자가 바로 이해할 수 있게 합니다.'],
  ['감독관을 위한 화면', '새로운 변화와 확인할 신호를 정리하고, 현장 확인 결과와 메모를 연결합니다. 시험 운영의 흐름을 기준으로 정보를 보여줍니다.'],
  ['기관에 남는 기록', '시험별 관측과 확인 과정을 보고서로 정리하는 흐름을 만듭니다. 여러 시험실의 기록을 관리하는 기관 운영으로 확장할 계획입니다.'],
] : [
  ['Purpose-built reception', 'Research a wireless reception design for assessment rooms. Extend observations that began on a phone into hardware built for the task.'],
  ['Observation through the exam', 'Connect the pre-exam baseline with changes during the session. Make reception status and interruptions clear to the operator.'],
  ['A view for proctors', 'Organize changes and signals that need attention, linked to on-site findings and notes. Design the information around the assessment workflow.'],
  ['Records for institutions', 'Bring observations and checks into a report for each exam, with a path toward managing records across multiple rooms.'],
];
const steps = ko ? [
  ['과제·루브릭 설정', '교수자가 학습 목표와 평가 기준, AI 활용 범위를 정합니다.'],
  ['과정 자동 기록', '과제 작업공간의 질문, AI 대화, 초안, 수정 이유와 버전 이력을 연결합니다.'],
  ['기여·점수 정리', 'AI 제안을 어떻게 검토하고 바꿨는지 분석해, 고유한 기여와 항목별 점수 초안을 근거와 함께 정리합니다.'],
  ['짧은 구술 확인', '학생의 선택과 수정에서 질문을 만들고, 자신의 판단을 직접 설명하도록 합니다.'],
  ['교수자 검토·확정', '과정 요약, 점수 근거와 구술 내용을 한 화면에서 확인하고 평가를 확정합니다.'],
] : [
  ['Set the task & rubric', 'The instructor defines learning goals, assessment criteria and the permitted role of AI.'],
  ['Record the process', 'Connect questions, AI conversations, drafts, revision rationales and version history within the assignment workspace.'],
  ['Connect contribution to scores', 'Analyze how AI suggestions were evaluated and changed, linking original contributions and draft rubric scores to evidence.'],
  ['Run a brief oral check', 'Build questions from the student’s choices and revisions so they can explain their own reasoning.'],
  ['Review & finalize', 'The instructor reviews the process summary, score evidence and oral responses together before finalizing the assessment.'],
];
const outcomes = ko ? [
  ['반복 검토는 자동화합니다.', '학생별 대화와 수정 이력을 학습 목표에 맞춰 요약하고, 루브릭 점수 초안과 근거를 함께 정리하는 것을 목표로 합니다.'],
  ['확인이 필요한 곳부터 봅니다.', '기록과 구술 답변에서 더 확인할 부분을 모아 보여줍니다. 교수자는 필요한 근거로 바로 이동해 판단에 집중할 수 있도록 설계합니다.'],
  ['큰 수업에서도 일관된 기준을 씁니다.', '수업 공통 루브릭과 학생별 구술 질문을 연결합니다. 글쓰기, 프로젝트, 문제해결 과제에 같은 평가 흐름을 적용하는 플랫폼을 준비합니다.'],
] : [
  ['Automate repetitive review.', 'The goal is to summarize each student’s conversations and revisions against learning objectives, with draft rubric scores and their evidence.'],
  ['Focus attention where it matters.', 'Bring together points that need clarification across the record and oral responses. Let instructors move directly to the evidence and concentrate on judgment.'],
  ['Use consistent criteria at scale.', 'Connect a shared course rubric with questions tailored to each student. Build a repeatable workflow for writing, projects and problem-solving assignments.'],
];
const roadmap = ko ? [
  ['기획·연구 준비', '시험 운영과 수업 평가의 사용 장면을 구체화하고, 필요한 기술과 검증 기준을 설계합니다.'],
  ['프로토타입 설계', '전용 수신 디바이스와 과정 기록·점수화·구술 확인의 핵심 흐름을 구현할 단계입니다.'],
  ['시험실·수업 검증', '학교와 기관의 실제 운영 조건에서 사용성, 관측 품질과 평가의 타당성을 검증할 계획입니다.'],
  ['기관 운영으로 확장', '기기 관리, 수업 운영, 기록과 보고서를 연결해 현장에서 지속적으로 쓰는 제품으로 발전시키겠습니다.'],
] : [
  ['Concept & research preparation', 'Define assessment-room and classroom use cases, then design the technical approach and validation criteria.'],
  ['Prototype design', 'Implement the core flows for dedicated reception, process recording, scoring and oral verification.'],
  ['Room & classroom validation', 'Plan studies with schools and institutions to evaluate usability, observation quality and assessment validity in real operating conditions.'],
  ['Institutional operation', 'Connect device management, course workflows, records and reporting into products that can support sustained institutional use.'],
];
---
<section class="vision-hero container">
  <div><h1>{ko ? '공정한 평가의\n다음 기준을 만듭니다.' : 'Building the next\nstandard for fair assessment.'}</h1><p class="page-lead">{ko ? '시험 공간을 살피는 전용 디바이스. AI와 함께한 학습을 증명하는 평가 플랫폼. 스마트 디텍터는 공정한 환경과 학생 고유의 성장을 함께 뒷받침하는 기술을 만들겠습니다.' : 'Dedicated devices for the assessment room. A platform that makes learning with AI visible. Smart Detector is shaping tools that support both fair conditions and each student’s own progress.'}</p><div class="button-row"><a class="button button-blue" href="#hardware">{ko ? '전용 디바이스' : 'Dedicated device'}<Icon name="arrow"/></a><a class="text-link" href="#learning-platform">{ko ? '학습 과정 평가 플랫폼' : 'Learning assessment platform'}<Icon name="arrow"/></a></div></div>
  <figure><img src="/assets/research/dedicated-device-concept.png" width="1536" height="1024" fetchpriority="high" alt={ko ? '시험실 책상에 놓인 흰색과 파란색 전용 무선 관측 디바이스의 제품 콘셉트 이미지' : 'Product concept rendering of a white and blue dedicated wireless observation device on an exam-room desk'}/><figcaption>{ko ? '제품 비전을 표현한 전용 디바이스 콘셉트 이미지' : 'A dedicated-device concept rendering illustrating the product vision'}</figcaption></figure>
</section>
<section class="vision-thesis"><div class="container"><h2>{ko ? '시험 공간에는 신뢰를.\n학습 과정에는 증거를.' : 'Trust in the room.\nEvidence of learning.'}</h2><p>{ko ? '공정한 평가는 시험을 치르는 환경과 학생이 실력을 보여주는 방식에서 시작합니다. 우리는 이 두 장면을 연결하는 하드웨어와 소프트웨어를 준비합니다.' : 'Fair assessment begins with the conditions of the exam and the way students demonstrate their ability. Our hardware and software vision connects those two moments.'}</p></div></section>
<section class="section" id="hardware"><div class="container">
  <div class="hardware-heading"><h2>{ko ? '시험실을 위한,\n전용 관측 디바이스.' : 'A dedicated observation\ndevice for assessment rooms.'}</h2><p>{ko ? '휴대폰 앱으로 시작한 현장 경험을 전용 장비로 이어갑니다. 시험실에 두고 관측을 이어가는 기기와 감독관의 확인·기록 흐름을 함께 설계해, 학교와 기관이 일상적으로 사용할 제품으로 만들겠습니다.' : 'Carry the experience that began with a phone app into dedicated equipment. Design the device, the proctor’s checks and the reporting flow together, toward a product schools and institutions can use in everyday operations.'}</p></div>
  <dl class="hardware-specs">{hardware.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
  <div class="hardware-flow"><p>{ko ? '디바이스가 지원할 시험 운영 흐름' : 'The assessment workflow we are designing for'}</p><ol>{(ko ? ['기준 측정', '연속 관측', '현장 확인', '보고서'] : ['Baseline', 'Observation', 'On-site check', 'Report']).map((item, index) => <li>{item}{index < 3 && <Icon name="arrow"/>}</li>)}</ol></div>
</div></section>
<section class="learning-section" id="learning-platform"><div class="container">
  <div class="section-heading"><h2>{ko ? 'AI와 함께한 생각을,\n학습의 증거로.' : 'Thinking with AI.\nEvidence of real learning.'}</h2><p>{ko ? '학습 과정 평가 플랫폼은 학생이 AI와 대화하며 세운 질문, 검토한 근거, 스스로 고친 내용을 자동으로 기록·점수화하고 짧은 구술로 확인하는 새로운 평가 프레임워크입니다.' : 'Our learning process assessment platform is a new framework for automatically recording and scoring the questions, evidence and revisions in a student’s collaboration with AI, then verifying understanding through a brief oral check.'}</p></div>
  <AssessmentDemo lang={lang}/>
</div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{ko ? '질문에서 구술까지,\n하나의 평가 흐름으로.' : 'From the first question\nto a clear explanation.'}</h2><p>{ko ? '최종 결과물에 이르기까지의 생각과 개선을 연결해,\n학생 자신의 판단과 기여가 드러나는 평가를 설계합니다.' : 'Connect the reasoning and improvements behind the final work,\nso the student’s own decisions and contribution become visible.'}</p></div><ol class="learning-steps">{steps.map(([title, text], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
<section class="section faculty-section"><div class="container faculty-layout"><div class="faculty-intro"><h2>{ko ? '교수자는,\n학습의 핵심을 봅니다.' : 'Give instructors time\nfor the judgment that matters.'}</h2><p>{ko ? '대규모 수업에서도 학생 한 명의 생각과 기여가 보이도록. 반복적인 기록 검토와 정리는 플랫폼이 돕고, 교수자는 학습 목표와 근거를 바탕으로 평가에 집중하는 것이 목표입니다.' : 'Make each student’s reasoning and contribution visible, even in large classes. The goal is for the platform to handle repetitive organization and review support, giving instructors more time to assess the evidence against learning goals.'}</p></div><dl class="faculty-outcomes">{outcomes.map(([title, text]) => <div><dt>{title}</dt><dd>{text}</dd></div>)}</dl></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{ko ? '제품으로 구현하는\n명확한 순서.' : 'A clear path\nfrom vision to product.'}</h2><p>{ko ? '전용 디바이스와 평가 플랫폼을\n현장에서 쓰는 제품으로 발전시키겠습니다.' : 'Developing dedicated devices and an assessment platform\nfor real institutional workflows.'}</p></div><ol class="vision-roadmap">{roadmap.map(([title, text], index) => <li><div class="roadmap-position"><span>{String(index + 1).padStart(2, '0')}</span>{index === 0 && <strong>{ko ? '현재 단계' : 'Current stage'}</strong>}</div><h3>{title}</h3><p>{text}</p></li>)}</ol></div></section>
<section class="section vision-join"><div class="container"><div><h2>{ko ? '다음 평가환경을,\n함께 만들겠습니다.' : 'Let’s build the next\nassessment environment.'}</h2><p>{ko ? '학교·대학의 평가 경험, 무선기기와 AI 기술, 제품을 현장으로 연결할 사업 역량을 기다립니다. 구체적인 사용 장면부터 함께 설계할 파트너를 찾습니다.' : 'We welcome expertise in school and university assessment, wireless hardware, AI and bringing products into practice. Join us in shaping the use cases and the tools around them.'}</p></div><div class="vision-contact-list"><a href={path(lang, 'contact') + '?type=institution'}>{ko ? '학교·기관 활용 논의' : 'Schools & institutional use'}<Icon name="arrow"/></a><a href={path(lang, 'contact') + '?type=partnership'}>{ko ? '기술·연구·사업 제휴' : 'Technology & research partnerships'}<Icon name="arrow"/></a><a href={path(lang, 'contact') + '?type=investment'}>{ko ? '투자 문의' : 'Investment inquiries'}<Icon name="arrow"/></a></div></div></section>
