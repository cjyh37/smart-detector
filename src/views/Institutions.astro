---
import PlayButton from '../components/PlayButton.astro';
import Icon from '../components/Icon.astro';
import ConsoleScreenshots from '../components/ConsoleScreenshots.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const contexts = lang === 'ko' ? [
  ['학교·학원', '정기시험과 모의시험', '교내 시험이나 모의시험에서 먼저 써 보며 기존 감독 절차에 어떻게 맞출지 점검할 수 있습니다.'],
  ['시험·자격 평가 운영기관', '여러 시험실과 감독관이 있는 시험', '시험실 규모와 운영 방식을 알려주시면 현재 앱으로 지원 가능한 범위와 활용법을 안내해 드립니다.'],
  ['채용·면접 운영팀', '채용 필기와 면접', '평가 방식과 장소 여건에 맞춰 무선신호 점검이 도움이 될지 함께 검토합니다.'],
] : [
  ['Schools & academies', 'Regular and mock exams', 'Test the app in school or practice exams first to see how signal checks and logs fit your existing proctoring rules.'],
  ['Exam & qualification teams', 'Multi-room exams with multiple proctors', 'Share your room scale and procedures, and we will outline what the current app supports and how to use it.'],
  ['Recruitment & interview teams', 'Written tests and interviews', 'We review your assessment format and venue setup together to see whether wireless signal checks would help.'],
];
---
<section class="page-intro container"><h1>{lang === 'ko' ? '학교와 기관의\n앱 활용 안내' : 'For schools\nand assessment teams'}</h1><p class="page-lead">{lang === 'ko' ? '학교 시험부터 자격시험, 채용 면접까지 무선신호 점검과 현장 기록을 돕습니다.' : 'Wireless signal checks and on-site reporting for school exams, qualification tests and interviews.'}</p><div class="button-row"><a class="button button-blue" href={path(lang, 'contact') + '?type=institution'}>{lang === 'ko' ? '기관 활용·도입 문의' : 'Discuss institutional use'}<Icon name="arrow"/></a><a class="text-link" href={path(lang, 'app')}>{lang === 'ko' ? '먼저 앱 살펴보기' : 'Explore the app first'}<Icon name="arrow"/></a></div></section>
<section class="section console-section" id="central-console" aria-labelledby="central-console-title">
  <div class="container">
    <div class="console-heading">
      <h2 id="central-console-title">{lang === 'ko' ? '시험장 중앙 관제' : 'Central monitoring'}</h2>
      <p>{lang === 'ko' ? '여러 시험장의 신호와 현장 확인 기록을 본부에서 한눈에 살피는 기관용 관제 기능을 구상·연구 준비 단계에서 검토하고 있습니다.' : 'A central console for exam headquarters to review signals and on-site check logs across venues is in concept and research preparation.'}</p>
    </div>
    <ConsoleScreenshots lang={lang}/>
  </div>
</section>
<section class="section section-soft"><div class="container"><h2>{lang === 'ko' ? '활용할 수 있는 환경' : 'Where the app may be useful'}</h2><div class="context-list">{contexts.map(([title, subtitle, body]) => <div><h3>{title}</h3><div><strong>{subtitle}</strong><p>{body}</p></div></div>)}</div><p class="small-note">{lang === 'ko' ? '구체적인 적용 방식은 기관의 시험 규정과 현장 여건에 따라 달라집니다.' : 'Actual deployment depends on your institution’s exam rules and venue conditions.'}</p></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '앱 사용과 기기 개발 참여' : 'Try the app or contribute to device plans'}</h2></div><div class="institution-options"><div><h3>{lang === 'ko' ? '무료 앱 바로 쓰기' : 'Use the free app right away'}</h3><p>{lang === 'ko' ? '별도 상담이나 가입 없이 바로 설치할 수 있습니다. 시험 전에 사용법과 수신 범위를 미리 확인해 보세요.' : 'Install directly with no consultation or registration. Review the workflow and reception limits before exam day.'}</p><PlayButton lang={lang} placement="institutions"/></div><div><h3>{lang === 'ko' ? '전용 디바이스 기능 제안' : 'Suggest dedicated-device features'}</h3><p>{lang === 'ko' ? '전용 디바이스는 현재 구상·연구 준비 단계입니다. 시험실 규모와 필요한 기록 항목을 알려주시면 설계에 반영하겠습니다. 시제품 대여나 현장 방문 지원은 현재 기본 서비스에 포함되지 않습니다.' : 'Dedicated hardware is in concept and research preparation. Share your room scale and logging needs to help shape the design. Prototype loans and on-site visits are not currently part of standard support.'}</p><a class="text-link" href={path(lang, 'research')}>{lang === 'ko' ? '디바이스 개발 계획 보기' : 'See device development plans'}<Icon name="arrow"/></a></div></div></div></section>
<section class="section section-soft"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '기관 문의 절차' : 'How an inquiry works'}</h2><p>{lang === 'ko' ? '기관 유형과 평가 방식, 시험실 규모를 함께 적어 주시면 더 정확히 안내해 드릴 수 있습니다.' : 'Include your institution type, exam format and room scale for tailored guidance.'}</p></div><ol class="contact-process">{(lang === 'ko' ? [['문의 접수', '운영 중인 시험과 필요한 내용을 알려주세요.'], ['여건 확인', '시험 방식과 현장 조건을 함께 살핍니다.'], ['지원 범위 안내', '현재 앱 기능과 향후 개발 계획을 안내합니다.'], ['활용·협력 논의', '도입 방식이나 연구 협력 방향을 정합니다.']] : [['Send inquiry', 'Tell us about your exams and what you need.'], ['Review setup', 'Check your exam format and venue conditions together.'], ['Outline scope', 'Explain current app features and upcoming plans.'], ['Plan next steps', 'Agree on app adoption or research collaboration.']]).map(([title, body], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></li>)}</ol><a class="button button-blue" href={path(lang, 'contact') + '?type=institution'}>{lang === 'ko' ? '기관 문의 시작하기' : 'Start an institutional inquiry'}<Icon name="arrow"/></a></div></section>

<section class="section"><div class="container institution-intro"><h2>{lang === 'ko' ? '시험감독 준비에\n참고할 글' : 'Guides for\nexam teams'}</h2><div><p>{lang === 'ko' ? '공식 발표 자료를 바탕으로 전자기기 점검, 무선신호 관측, 현장 기록 기준을 정리했습니다.' : 'Read official sources alongside practical notes on device checks, wireless observation and on-site records.'}</p><a class="text-link" href={path(lang, 'journal', 'suneung-device-checks-2027')}>{lang === 'ko' ? '수능 부정행위 예방과 전자기기 확인' : 'Suneung device rules and exam integrity'}<Icon name="arrow"/></a><a class="text-link" href={path(lang, 'journal', 'tax-accountant-exam-ai-cheating')}>{lang === 'ko' ? '세무사 시험 AI 부정행위 이후의 감독 점검' : 'Exam operations after the tax accountant case'}<Icon name="arrow"/></a></div></div></section>

<style>
  .console-section { padding-top: 0; padding-bottom: 64px; }
  .console-heading { margin-bottom: 24px; }
  .console-heading h2 { font-size: 32px; }
  .console-heading p { margin-top: 12px; font-size: 17px; }
  @media (max-width: 680px) {
    .console-section { padding-bottom: 48px; }
    .console-heading h2 { font-size: 28px; }
    .console-heading p { font-size: 16px; }
  }
</style>
