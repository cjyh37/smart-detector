---
import PlayButton from '../components/PlayButton.astro';
import Icon from '../components/Icon.astro';
import ConsoleScreenshots from '../components/ConsoleScreenshots.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const contexts = lang === 'ko' ? [
  ['학교·학원', '정기시험과 모의시험', '시험 전에 앱을 사용해 보고, 기존 감독 절차에서 신호 확인과 기록을 어떻게 활용할지 검토할 수 있습니다.'],
  ['시험·자격 평가 운영기관', '여러 시험실과 감독관이 있는 시험', '시험실 운영 방식과 감독관이 확인해야 할 상황을 알려주세요. 현재 앱에서 지원하는 기능을 기준으로 활용 방법을 안내하겠습니다.'],
  ['채용·면접 운영팀', '채용 시험과 면접', '평가 방식과 장소에 따라 필요한 정보가 다릅니다. 운영 조건을 듣고 무선신호 확인이 도움이 될지 함께 검토하겠습니다.'],
] : [
  ['Schools & academies', 'Preparing classroom and practice exams', 'Try the app before an exam and consider where signal checks and records could fit into your existing proctoring procedures.'],
  ['Exam & qualification teams', 'Exams with multiple rooms and proctors', 'Tell us how you run your exam rooms and what proctors need to check. We can explain which current app features may help.'],
  ['Recruitment & interview teams', 'Recruitment tests and interviews', 'Requirements vary by assessment format and location. We can discuss whether wireless signal checks would be useful in your setting.'],
];
---
<section class="page-intro container"><h1>{lang === 'ko' ? '학교와 기관의\n앱 활용 안내' : 'For schools\nand assessment teams'}</h1><p class="page-lead">{lang === 'ko' ? '학교 시험부터 자격시험, 채용 면접까지 무선신호 확인과 현장 기록을 돕습니다.' : 'Wireless signal checks and on-site records for school exams, qualification tests and interviews.'}</p><div class="button-row"><a class="button button-blue" href={path(lang, 'contact') + '?type=institution'}>{lang === 'ko' ? '기관 활용·도입 문의' : 'Discuss institutional use'}<Icon name="arrow"/></a><a class="text-link" href={path(lang, 'app')}>{lang === 'ko' ? '먼저 앱 살펴보기' : 'Explore the app first'}<Icon name="arrow"/></a></div></section>
<section class="section console-section" id="central-console" aria-labelledby="central-console-title">
  <div class="container">
    <div class="console-heading">
      <h2 id="central-console-title">{lang === 'ko' ? '시험장 중앙 관제' : 'Central monitoring'}</h2>
      <p>{lang === 'ko' ? '여러 시험장의 신호와 확인 기록을 본부에서 함께 보는 기능을 준비합니다.' : 'We’re preparing a shared view of signals and check records for the exam office.'}</p>
    </div>
    <ConsoleScreenshots lang={lang}/>
  </div>
</section>
<section class="section section-soft"><div class="container"><h2>{lang === 'ko' ? '활용을 검토할 수 있는 환경' : 'Where the app may be useful'}</h2><div class="context-list">{contexts.map(([title, subtitle, body]) => <div><h3>{title}</h3><div><strong>{subtitle}</strong><p>{body}</p></div></div>)}</div><p class="small-note">{lang === 'ko' ? '활용 가능성을 검토하기 위한 예시입니다. 실제 적용 범위는 기관의 운영 조건에 따라 달라집니다.' : 'These are possible use cases. Suitability depends on your institution’s operating conditions.'}</p></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '앱 사용과 기기 개발 참여' : 'Try the app or contribute to device plans'}</h2></div><div class="institution-options"><div><h3>{lang === 'ko' ? '무료 앱 사용' : 'Try the free app'}</h3><p>{lang === 'ko' ? '별도 상담이나 기관 가입 없이 설치할 수 있습니다. 시험 전에 사용 방법과 신호 확인 범위를 살펴봐 주세요.' : 'You can install it without a consultation or institution registration. Check the instructions and signal reception limits before an exam.'}</p><PlayButton lang={lang} placement="institutions"/></div><div><h3>{lang === 'ko' ? '전용 디바이스에 필요한 기능 제안' : 'Help define the dedicated device'}</h3><p>{lang === 'ko' ? '전용 디바이스는 기획·연구 준비 단계입니다. 시험실 규모와 운영 방식, 필요한 기록을 알려주시면 제품 설계에 참고하겠습니다. 시제품 제공과 현장 방문은 현재 기본 서비스에 포함되지 않습니다.' : 'Dedicated hardware is in concept and research preparation. Share your room sizes, procedures and record-keeping needs to help inform the design. Prototypes and on-site visits are not currently part of a standard service.'}</p><a class="text-link" href={path(lang, 'research')}>{lang === 'ko' ? '디바이스 개발 계획 보기' : 'See device development plans'}<Icon name="arrow"/></a></div></div></div></section>
<section class="section section-soft"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '기관 문의 절차' : 'How an inquiry works'}</h2><p>{lang === 'ko' ? '기관 유형과 평가 방식, 시험실 규모를 알려주시면 활용 방법을 검토하는 데 도움이 됩니다.' : 'Include your institution type, assessment format and room size so we can consider how the app might fit.'}</p></div><ol class="contact-process">{(lang === 'ko' ? [['문의', '운영 중인 시험과 필요한 기능을 알려주세요.'], ['필요 확인', '시험 방식과 사용 조건을 확인합니다.'], ['가능한 범위 안내', '현재 앱의 기능과 향후 개발 계획을 안내합니다.'], ['다음 단계 합의', '앱 활용이나 연구 협력의 다음 단계를 논의합니다.']] : [['Get in touch', 'Describe your exams and the features you need.'], ['Understand the need', 'Review your assessment format and operating conditions.'], ['Clarify the scope', 'Explain current app features and development plans.'], ['Agree next steps', 'Discuss next steps for app use or research cooperation.']]).map(([title, body], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></li>)}</ol><a class="button button-blue" href={path(lang, 'contact') + '?type=institution'}>{lang === 'ko' ? '기관 문의 시작하기' : 'Start an institutional inquiry'}<Icon name="arrow"/></a></div></section>

<section class="section"><div class="container institution-intro"><h2>{lang === 'ko' ? '시험감독 준비에\n참고할 글' : 'Guides for\nexam teams'}</h2><div><p>{lang === 'ko' ? '공식 발표와 함께 전자기기 확인, 무선신호 관측, 현장 기록에 필요한 내용을 살펴보세요.' : 'Read official sources alongside practical notes on device checks, wireless observation and on-site records.'}</p><a class="text-link" href={path(lang, 'journal', 'suneung-device-checks-2027')}>{lang === 'ko' ? '수능 부정행위 예방과 전자기기 확인' : 'Suneung device rules and exam integrity'}<Icon name="arrow"/></a><a class="text-link" href={path(lang, 'journal', 'tax-accountant-exam-ai-cheating')}>{lang === 'ko' ? '세무사 시험 AI 부정행위 이후의 감독 점검' : 'Exam operations after the tax accountant case'}<Icon name="arrow"/></a></div></div></section>

<style>
  .console-section { padding-top: 0; padding-bottom: 64px; }
  .console-heading { margin-bottom: 24px; }
  .console-heading h2 { font-size: 32px; }
  .console-heading p { margin-top: 12px; font-size: 17px; }
  @media (max-width: 680px) {
    .console-section { padding-bottom: 48px; }
    .console-heading h2 { font-size: 28px; }
    .console-heading p { font-size: 16px; }
  }
</style>
