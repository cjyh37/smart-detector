---
import PlayButton from '../components/PlayButton.astro';
import Icon from '../components/Icon.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const contexts = lang === 'ko' ? [
  ['학교·학원', '정기시험과 모의시험을 준비하는 현장', '평가 전에 앱의 관측 범위와 사용 흐름을 확인하고, 기존 감독 절차 안에서 활용할 방법을 검토할 수 있습니다.'],
  ['시험·자격 평가 운영기관', '여러 감독관과 평가 절차를 운영하는 현장', '기존 운영 방식과 확인이 필요한 상황을 함께 이야기하고, 현재 앱으로 가능한 범위를 안내합니다.'],
  ['채용·면접 운영팀', '동일한 평가 조건을 고민하는 현장', '운영 목적과 현장 조건을 먼저 듣습니다. 어떤 관측 정보가 실제로 필요한지 함께 질문하는 단계입니다.'],
] : [
  ['Schools & academies', 'Preparing classroom and practice exams', 'Explore the observation limits and workflow before an assessment, then consider how the app fits within your existing proctoring procedures.'],
  ['Exam & qualification teams', 'Coordinating proctors and assessment procedures', 'Discuss your operating process and the situations that need attention. We can explain what the current app supports.'],
  ['Recruitment & interview teams', 'Working toward consistent assessment conditions', 'We start with your goals and environment. Together, we can identify which kinds of observation would be useful in practice.'],
];
---
<section class="page-intro container"><h1>{lang === 'ko' ? '평가환경은 다르니까.\n현장 이야기부터 듣겠습니다.' : 'Every assessment is different.\nLet’s start with yours.'}</h1><p class="page-lead">{lang === 'ko' ? '무료 앱을 직접 활용하는 방법부터 앞으로 필요한 기기까지. 학교와 기관이 공정한 평가환경을 준비하는 과정에 함께하고 싶습니다.' : 'From using the free app to identifying the tools you need next, we want to understand how your institution prepares a fair assessment environment.'}</p><div class="button-row"><a class="button button-blue" href={path(lang, 'contact') + '?type=institution'}>{lang === 'ko' ? '기관 활용·도입 문의' : 'Discuss institutional use'}<Icon name="arrow"/></a><a class="text-link" href={path(lang, 'app')}>{lang === 'ko' ? '먼저 앱 살펴보기' : 'Explore the app first'}<Icon name="arrow"/></a></div></section>
<section class="section section-soft"><div class="container"><h2>{lang === 'ko' ? '이런 현장의 이야기를\n기다립니다.' : 'Conversations\nwe welcome.'}</h2><div class="context-list">{contexts.map(([title, subtitle, body]) => <div><h3>{title}</h3><div><strong>{subtitle}</strong><p>{body}</p></div></div>)}</div><p class="small-note">{lang === 'ko' ? '위 내용은 활용을 논의할 수 있는 환경의 예시이며, 실제 도입 실적을 의미하지 않습니다.' : 'These are examples of settings for discussion, not claims of existing deployments.'}</p></div></section>
<section class="section"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '지금의 활용과\n앞으로의 협력.' : 'Use what is here.\nHelp shape what is next.'}</h2></div><div class="institution-options"><div><h3>{lang === 'ko' ? '무료 앱부터 직접 사용해 보세요.' : 'Start with the free app.'}</h3><p>{lang === 'ko' ? '설치를 위한 별도 상담이나 기관 가입은 필요하지 않습니다. 실제 평가 전에 사용 방법과 관측 범위를 확인해 주세요.' : 'No consultation or institution registration is needed to install. Check the workflow and observation limits before a real assessment.'}</p><PlayButton lang={lang} placement="institutions"/></div><div><h3>{lang === 'ko' ? '필요한 관측 도구를 함께 고민합니다.' : 'Help define a useful observation tool.'}</h3><p>{lang === 'ko' ? '전용 하드웨어는 연구 준비 단계입니다. 현장의 요구를 듣고 협력 가능성을 검토합니다. 시제품 제공이나 현장 방문을 기본으로 약속하는 서비스는 아닙니다.' : 'Dedicated hardware is in research preparation. We welcome input about field needs and potential cooperation. Prototype provision or on-site visits are not standard services we currently promise.'}</p><a class="text-link" href={path(lang, 'research')}>{lang === 'ko' ? '현재 연구 단계 확인' : 'See the current research stage'}<Icon name="arrow"/></a></div></div></div></section>
<section class="section section-soft"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '문의는 간단하게.\n다음 단계는 함께.' : 'A simple first contact.\nA considered next step.'}</h2><p>{lang === 'ko' ? '기관 유형, 평가 방식, 시험실 규모,\n현재 필요한 점을 알려주세요.' : 'Tell us your institution type, assessment format,\nroom scale and current needs.'}</p></div><ol class="contact-process">{(lang === 'ko' ? [['문의', '현장 상황을 알려주세요.'], ['필요 확인', '목적과 조건을 함께 살펴봅니다.'], ['가능한 범위 안내', '현재 앱과 연구 준비 범위를 설명합니다.'], ['다음 단계 합의', '서로 가능한 협력을 정합니다.']] : [['Get in touch', 'Describe your setting.'], ['Understand the need', 'Discuss goals and conditions.'], ['Clarify the scope', 'Review the app and research stage.'], ['Agree next steps', 'Decide what makes sense together.']]).map(([title, body], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></li>)}</ol><a class="button button-blue" href={path(lang, 'contact') + '?type=institution'}>{lang === 'ko' ? '기관 문의 시작하기' : 'Start an institutional inquiry'}<Icon name="arrow"/></a></div></section>
