---
import PlayButton from '../components/PlayButton.astro';
import Icon from '../components/Icon.astro';
import Workflow from '../components/Workflow.astro';
import ReportPreview from '../components/ReportPreview.astro';
import Tutorial from '../components/Tutorial.astro';
import ResearchPreview from '../components/ResearchPreview.astro';

import Faq from '../components/Faq.astro';
import InstallBlock from '../components/InstallBlock.astro';
import JournalList from '../components/JournalList.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
---
<section class="hero container">
  <div class="hero-copy"><h1>{lang === 'ko' ? <>시험실 무선신호를<br/><em>휴대폰으로 확인하세요.</em></> : <>Check wireless signals<br/><em>in the exam room.</em></>}</h1><p class="hero-lead">{lang === 'ko' ? '스마트 글래스·이어폰·카메라에서 수신 가능한 무선신호를 살펴보고, 감독관이 확인한 내용을 기록합니다. 스마트 디텍터는 Android에서 무료로 사용할 수 있습니다.' : 'Smart Detector helps proctors check wireless signals a phone can receive from devices such as smart glasses, earphones and cameras, then record their findings. The Android app is free.'}</p><div class="hero-actions"><PlayButton lang={lang} placement="hero"/><a class="text-link" href={path(lang, 'app')}>{lang === 'ko' ? '앱으로 할 수 있는 일' : 'What the app can do'}<Icon name="arrow"/></a></div><div class="app-section-links hero-section-links"><a class="text-link" href="#report">{lang === 'ko' ? '보고서 예시' : 'Report example'}<Icon name="arrow"/></a><a class="text-link" href="#tutorial">{lang === 'ko' ? '튜토리얼 보기' : 'Watch tutorial'}<Icon name="play"/></a></div><p class="hero-availability">{lang === 'ko' ? 'Android 무료 제공' : 'Korean-language Android app'}<span aria-hidden="true">·</span>{lang === 'ko' ? 'iOS 개발 중' : 'iOS in development'}</p></div>
  <figure class="hero-product"><div class="hero-product-head"><span>Smart Detector</span><span>Android</span></div><div class="hero-device"><img src="/assets/screenshots/monitoring.png" width="780" height="1688" alt={lang === 'ko' ? '시험 중 새 신호와 감독관 판단을 확인하는 스마트 디텍터 화면 시안' : 'Updated Smart Detector monitoring design with new signals and check statuses, Korean interface'} fetchpriority="high"/></div><figcaption>{lang === 'ko' ? '시험 중 새로 수신한 신호와 확인 상태' : 'New signals and the proctor’s check status'}<small>{lang === 'ko' ? '앱 화면 시안 · 예시 데이터' : 'Interface design · Example data'}</small></figcaption></figure>
</section>
<div class="mission-strip"><div class="container"><p>{lang === 'ko' ? '시험과 면접을 운영하는 분들을 위해 만들고 있습니다.' : 'Tools for the people running exams and interviews.'}</p><a href={path(lang, 'about')}>{lang === 'ko' ? '스마트 디텍터 소개' : 'About Smart Detector'}<Icon name="arrow"/></a></div></div>
<section class="section" id="how-it-works"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '시험 전 준비부터\n시험 종료까지' : 'Using the app\nduring an exam'}</h2><p>{lang === 'ko' ? '빈 강의실을 먼저 측정하고, 입실 후와 시험 중에 달라진 신호를 확인합니다.' : 'Measure the empty room first, then review changes as candidates arrive and the exam begins.'}</p></div><Workflow lang={lang}/><div class="section-tail"><p>{lang === 'ko' ? '새 신호가 보이면 현장에서 확인해 주세요. 앱이 부정행위를 자동으로 판정하지는 않습니다.' : 'A new signal needs an on-site check. The app does not determine whether cheating has occurred.'}</p><a class="text-link" href={path(lang, 'app')}>{lang === 'ko' ? '앱 기능과 확인 범위 보기' : 'See app features and limits'}<Icon name="arrow"/></a></div></div></section>
<ReportPreview lang={lang}/>
<Tutorial lang={lang}/>
<ResearchPreview lang={lang}/>
<section class="section"><div class="container institution-intro"><h2>{lang === 'ko' ? '학교와 기관에서\n사용하려면' : 'Using Smart Detector\nat your institution'}</h2><div><p>{lang === 'ko' ? '시험실 규모와 운영 방식을 알려주시면 앱을 어떻게 활용할 수 있을지 안내하겠습니다. 전용기기에 필요한 기능이나 연구 협력 제안도 받고 있습니다.' : 'Tell us about your room size and assessment procedures so we can discuss how the app could fit. We also welcome hardware requirements and research proposals.'}</p><a class="text-link" href={path(lang, 'institutions')}>{lang === 'ko' ? '기관 활용 안내' : 'For institutions'}<Icon name="arrow"/></a><a class="text-link" href={path(lang, 'contact') + '?type=partnership'}>{lang === 'ko' ? '기술·연구 제휴 문의' : 'Discuss a research partnership'}<Icon name="arrow"/></a></div></div></section>
<section class="section journal-section"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '사용 가이드와\n개발 이야기' : 'Guides and\ndevelopment notes'}</h2><a class="text-link" href={path(lang, 'journal')}>{lang === 'ko' ? '연구노트 전체 보기' : 'Visit the journal'}<Icon name="arrow"/></a></div><JournalList lang={lang}/></div></section>
<Faq lang={lang}/>
<InstallBlock lang={lang}/>
