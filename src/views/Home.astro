---
import PlayButton from '../components/PlayButton.astro';
import Icon from '../components/Icon.astro';
import Workflow from '../components/Workflow.astro';
import ReportPreview from '../components/ReportPreview.astro';
import Tutorial from '../components/Tutorial.astro';
import ResearchPreview from '../components/ResearchPreview.astro';
import ConsoleScreenshots from '../components/ConsoleScreenshots.astro';

import Faq from '../components/Faq.astro';
import InstallBlock from '../components/InstallBlock.astro';
import JournalList from '../components/JournalList.astro';
import { path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
---
<section class="hero container">
  <div class="hero-copy"><h1>{lang === 'ko' ? '시험 중 무선신호를\n확인하는 앱' : 'Wireless signal checks\nfor exams'}</h1><p class="hero-lead">{lang === 'ko' ? '시험 부정행위 예방을 돕는 무료 감독 보조 앱입니다. 빈 강의실을 90초 측정해 두면, 시험 시작 뒤 새로 수신한 신호를 진동으로 알려줍니다. 새 신호는 스마트안경·이어폰·카메라처럼 무선신호를 내는 기기를 현장에서 확인할 단서입니다.' : 'A free app for exam proctors. Measure the empty room for 90 seconds, and the phone vibrates when it receives a new signal after the exam starts. A new signal is a lead for checking devices that emit wireless signals, such as smart glasses, earphones and cameras.'}</p><div class="hero-actions"><PlayButton lang={lang} placement="hero"/><a class="text-link" href={path(lang, 'app')}>{lang === 'ko' ? '앱으로 할 수 있는 일' : 'What the app can do'}<Icon name="arrow"/></a></div><div class="app-section-links hero-section-links"><a class="text-link" href="#report">{lang === 'ko' ? '보고서 예시' : 'Report example'}<Icon name="arrow"/></a><a class="text-link" href="#tutorial">{lang === 'ko' ? '1분 사용법 영상' : 'One-minute tutorial'}<Icon name="play"/></a></div><p class="hero-availability">{lang === 'ko' ? 'Android 12 이상' : 'Android 12 or later'}<span aria-hidden="true">·</span>{lang === 'ko' ? '가입 없이 무료' : 'Free, no account'}<span aria-hidden="true">·</span>{lang === 'ko' ? 'iOS 개발 중' : 'Korean interface'}{lang === 'en' && <><span aria-hidden="true">·</span>iOS in development</>}</p></div>
  <figure class="hero-product"><div class="hero-product-head"><span>Smart Detector</span><span>Android</span></div><div class="hero-device"><img src={lang === 'ko' ? '/assets/screenshots/monitoring.png' : '/assets/localized/en/monitoring.webp'} width="780" height="1688" alt={lang === 'ko' ? '시험 중 새 신호와 감독관 판단을 확인하는 스마트 디텍터 화면' : 'Smart Detector monitoring screen with new signals and check statuses'} fetchpriority="high"/></div><figcaption>{lang === 'ko' ? '시험 중 새로 수신한 신호와 확인 상태' : 'New signals and the proctor’s check status'}</figcaption></figure>
</section>
<div class="mission-strip"><div class="container"><p>{lang === 'ko' ? '스마트안경과 무선 이어폰은 눈으로만 가려내기 어렵습니다. 휴대폰이 새로 수신한 무선신호가 감독관이 확인할 단서가 됩니다.' : 'Smart glasses and wireless earphones are hard to spot by eye alone. A signal the phone newly receives gives the proctor something to check.'}</p><a href={path(lang, 'about')}>{lang === 'ko' ? '스마트 디텍터 소개' : 'About Smart Detector'}<Icon name="arrow"/></a></div></div>
<section class="section" id="how-it-works"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '시험 한 번에\n버튼 세 번이면 됩니다.' : 'Three button presses\nfor each exam'}</h2><p>{lang === 'ko' ? '시험 전, 시작할 때, 끝난 뒤에 한 번씩 누릅니다. 그 사이에 새로 수신한 신호는 앱이 따로 보여줍니다.' : 'Press once before the exam, once when it starts and once when it ends. The app shows the signals it newly receives in between separately.'}</p></div><Workflow lang={lang}/><div class="section-tail"><p>{lang === 'ko' ? '앱은 새 신호를 알려주고, 확인과 판단은 감독관이 합니다. 신호만으로는 부정행위 여부를 알 수 없습니다.' : 'The app flags new signals; checking and judging them is the proctor’s job. A signal alone does not show whether anyone cheated.'}</p><a class="text-link" href={path(lang, 'app')}>{lang === 'ko' ? '앱 기능과 한계 보기' : 'See app features and limits'}<Icon name="arrow"/></a></div></div></section>
<ReportPreview lang={lang}/>
<Tutorial lang={lang}/>
<ResearchPreview lang={lang}/>
<section class="section institution-home" id="institution-use">
  <div class="container institution-home-grid">
    <div class="institution-home-copy">
      <h2>{lang === 'ko' ? '학교·기관 활용' : 'For institutions'}</h2>
      <p>{lang === 'ko' ? '시험장별 신호와 현장 기록을 모아 보는 기관용 기능을 준비합니다.' : 'We’re preparing tools that bring signals and on-site records from every venue together.'}</p>
      <a class="text-link" href={path(lang, 'institutions') + '#central-console'}>{lang === 'ko' ? '기관 활용 안내' : 'Explore institutional use'}<Icon name="arrow"/></a>
    </div>
    <ConsoleScreenshots lang={lang} variant="overview"/>
  </div>
</section>
<section class="section journal-section"><div class="container"><div class="section-heading"><h2>{lang === 'ko' ? '수능·자격시험 감독을 위한\n현장 가이드' : 'Proctoring guides for\nSuneung and licensing exams'}</h2><a class="text-link" href={path(lang, 'journal')}>{lang === 'ko' ? '연구노트 전체 보기' : 'Visit the journal'}<Icon name="arrow"/></a></div><JournalList lang={lang} limit={3}/></div></section>
<Faq lang={lang}/>
<InstallBlock lang={lang}/>

<style>
  .institution-home { padding-block: 64px; }
  .institution-home-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.6fr); gap: 56px; align-items: center; }
  .institution-home-copy p { max-width: 380px; margin-top: 18px; font-size: 17px; }
  .institution-home-copy .text-link { margin-top: 14px; }
  @media (max-width: 900px) {
    .institution-home-grid { gap: 32px; }
    .institution-home-copy h2 { font-size: 32px; }
  }
  @media (max-width: 680px) {
    .institution-home { padding-block: 48px; }
    .institution-home-grid { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .institution-home-copy h2 { font-size: 28px; }
    .institution-home-copy p { margin-top: 12px; font-size: 16px; }
    .institution-home-copy .text-link { margin-top: 8px; }
  }
</style>
