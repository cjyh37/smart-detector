---
import JournalList from '../components/JournalList.astro';
import { categoryLabels } from '../data/journal';
import { type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
---
<section class="page-intro container"><h1>{lang === 'ko' ? '공정한 평가를 위한\n생각과 기록.' : 'Notes on building\nfor fairer assessments.'}</h1><p class="page-lead">{lang === 'ko' ? '현장에서 앱을 이해하는 방법, 제품을 만드는 이유, 앞으로 풀고 싶은 질문을 나눕니다.' : 'Field guides, the reasons behind the product, and the questions we want to explore next.'}</p></section>
<section class="journal-index container"><div class="journal-filters" data-journal-filters hidden aria-label={lang === 'ko' ? '글 분류' : 'Article category'}>{Object.entries(categoryLabels[lang]).map(([id, name]) => <button type="button" data-filter={id} aria-pressed={id === 'all' ? 'true' : 'false'}>{name}</button>)}</div><JournalList lang={lang}/><p class="journal-filter-status sr-only" role="status" aria-live="polite"></p><p class="journal-endnote">{lang === 'ko' ? '실제 연구가 진행되면 실험 조건, 관측 결과와 한계를 함께 기록하겠습니다.' : 'As research progresses, we plan to document the test conditions, observations and limitations together.'}</p></section>
