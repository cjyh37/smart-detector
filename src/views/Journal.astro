---
import JournalList from '../components/JournalList.astro';
import { categoryLabels } from '../data/journal';
import { type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
---
<section class="page-intro container"><h1>{lang === 'ko' ? '시험감독 가이드와 개발 이야기' : 'Guides and development notes'}</h1><p class="page-lead">{lang === 'ko' ? '수능·국가자격시험의 부정행위 예방, 전자기기 확인, 앱 사용법을 다룹니다. 공식 발표를 살펴보고 시험 운영에 필요한 내용을 정리합니다.' : 'Guides to exam integrity, electronic-device checks and the app, with official sources on Suneung and qualification exams in Korea.'}</p></section>
<section class="journal-index container"><div class="journal-filters" data-journal-filters hidden aria-label={lang === 'ko' ? '글 분류' : 'Article category'}>{Object.entries(categoryLabels[lang]).map(([id, name]) => <button type="button" data-filter={id} aria-pressed={id === 'all' ? 'true' : 'false'}>{name}</button>)}</div><JournalList lang={lang}/><p class="journal-filter-status sr-only" role="status" aria-live="polite"></p><p class="journal-endnote">{lang === 'ko' ? '연구를 시작하면 실험 방법과 결과도 이곳에 공유하겠습니다.' : 'We will share test methods, findings and limitations here as the research progresses.'}</p></section>
