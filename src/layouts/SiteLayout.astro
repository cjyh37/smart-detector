---
import Icon from '../components/Icon.astro';
import PlayButton from '../components/PlayButton.astro';
import type { ArticleMeta } from '../data/journal';
import { SITE, EMAIL, PRIVACY, labels, path, type Lang, type PageKey } from '../data/site';
import '../styles/global.css';
import '../styles/media.css';
import '../styles/research-vision.css';
interface Props { lang: Lang; page: PageKey; title: string; description: string; slug?: string; article?: ArticleMeta; noindex?: boolean; }
const { lang, page, title, description, slug = '', article, noindex = false } = Astro.props;
const t = labels[lang];
const koPath = path('ko', page, slug);
const enPath = path('en', page, slug);
const canonical = SITE + path(lang, page, slug);
const ogImage = SITE + `/assets/social${lang === 'en' ? '-en' : ''}.png?v=20261116-exam-detection`;
const nav: PageKey[] = ['app', 'research', 'institutions', 'journal', 'contact'];
const breadcrumbs = [
  { name: t.home, url: SITE + path(lang) },
  ...(page !== 'home' ? [{ name: t[page], url: SITE + path(lang, page) }] : []),
  ...(article ? [{ name: article.title, url: canonical }] : []),
];
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', '@id': SITE + '/#organization', name: '스마트 디텍터', alternateName: 'Smart Detector', url: SITE + '/', email: EMAIL },
  { '@type': 'WebSite', '@id': SITE + '/#website', url: SITE + '/', name: '스마트 디텍터', alternateName: 'Smart Detector', inLanguage: ['ko', 'en', 'ja'], publisher: { '@id': SITE + '/#organization' } },
  { '@type': 'WebPage', '@id': canonical + '#page', url: canonical, name: title, description, inLanguage: lang, isPartOf: { '@id': SITE + '/#website' }, ...(page !== 'home' ? { breadcrumb: { '@id': canonical + '#breadcrumb' } } : {}), ...(article ? { mainEntity: { '@id': canonical + '#article' } } : {}) },
  ...(page !== 'home' ? [{ '@type': 'BreadcrumbList', '@id': canonical + '#breadcrumb', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: item.url })) }] : []),
  ...(article ? [{ '@type': 'BlogPosting', '@id': canonical + '#article', url: canonical, headline: article.title, description, inLanguage: lang, image: ogImage, datePublished: article.date, dateModified: article.updated || article.date, mainEntityOfPage: { '@id': canonical + '#page' }, author: { '@type': 'Organization', '@id': SITE + '/#organization', name: t.brand, url: SITE + path(lang, 'about') }, publisher: { '@id': SITE + '/#organization' } }] : []),
] };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#0b47b5"/>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}/>
    <meta name="google-site-verification" content="ABUjBZu12KW5HPL2hmBqH1joQ2i3LJen_rjr-b9VvVk"/>
    <meta name="naver-site-verification" content="7f64338a37dfa1ff7829980a5ccbac3a8c45981b"/>
    <link rel="canonical" href={canonical}/>
    {!noindex && <><link rel="alternate" hreflang="ko" href={SITE + koPath}/><link rel="alternate" hreflang="en" href={SITE + enPath}/><link rel="alternate" hreflang="ja" href={SITE + '/ja' + koPath}/><link rel="alternate" hreflang="x-default" href={SITE + koPath}/></>}
    <link rel="icon" type="image/svg+xml" href="/assets/icon.svg"/>
    <link rel="preload" href="/assets/PretendardVariable.woff2" as="font" type="font/woff2" crossorigin/>
    <meta property="og:type" content={article ? 'article' : 'website'}/>
    {article && <><meta property="article:published_time" content={article.date}/><meta property="article:modified_time" content={article.updated || article.date}/></>}
    <meta property="og:site_name" content={t.brand}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={ogImage}/>
    <meta property="og:image:width" content="1200"/>
    <meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content={lang === 'ko' ? '스마트 디텍터 시험 부정행위 탐지 보조 앱' : 'Smart Detector exam proctoring app'}/>
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'}/>
    <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImage}/>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>}
    <script is:inline src="/assets/analytics.js?v=20261117-site" defer></script>
  {!noindex && <script is:inline>
      (() => {
        const supported = ['ko', 'en', 'ja'];
        const current = document.documentElement.lang;
        const storageKey = 'smart-detector-language';
        function localizedUrl(language) {
          const url = new URL(location.href);
          const path = url.pathname.replace(/^\/(en|ja)(?=\/|$)/, '') || '/';
          url.pathname = (language === 'ko' ? '' : '/' + language) + path;
          return url;
        }
        let saved;
        try { saved = localStorage.getItem(storageKey); } catch {}
        if (current === 'ko' && saved !== current && supported.includes(saved)) {
          location.replace(localizedUrl(saved)); return;
        }
        document.addEventListener('DOMContentLoaded', () => {
          const select = document.getElementById('site-language');
          select.value = current;
          select.addEventListener('change', () => {
            try { localStorage.setItem(storageKey, select.value); } catch {}
            location.assign(localizedUrl(select.value));
          });
        });
      })();
    </script>}</head>
  <body class:list={[`page-${page}`, article && 'page-article', (page === 'home' || page === 'app') && 'has-mobile-install']}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={path(lang)} aria-label={`${t.brand} ${t.home}`}><img src="/assets/icon.svg" alt="" width="32" height="32"/><span>{t.brand}</span></a>
        <nav class="desktop-nav" aria-label={lang === 'ko' ? '주요 메뉴' : 'Main navigation'}>{nav.map(key => <a href={path(lang, key)} aria-current={page === key ? 'page' : undefined}>{t[key]}</a>)}</nav>
        <div class="header-actions"><select id="site-language" aria-label={lang === 'ko' ? '언어 선택' : 'Select language'}>
          <option lang="ko" value="ko" selected={lang === 'ko'}>한국어</option>
          <option lang="en" value="en" selected={lang === 'en'}>English</option>
          <option lang="ja" value="ja">日本語</option>
        </select><a class="header-install" href="https://play.google.com/store/apps/details?id=ai.fwth.smartdetector" data-store-link data-placement="header">{t.installShort}<Icon name="arrow"/></a></div>
        <details class="mobile-menu"><summary aria-label={t.menu}><Icon name="menu"/><span>{t.menu}</span></summary><nav aria-label={lang === 'ko' ? '모바일 메뉴' : 'Mobile navigation'}>{nav.map(key => <a href={path(lang, key)} aria-current={page === key ? 'page' : undefined}>{t[key]}<Icon name="arrow"/></a>)}<a href={path(lang, 'about')}>{t.about}<Icon name="arrow"/></a></nav></details>
      </div>
    </header>
    <main id="main"><slot/></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <div class="footer-purpose"><a class="brand" href={path(lang)}><img src="/assets/icon.svg" alt="" width="32" height="32"/>{t.brand}</a><p>{lang === 'ko' ? '시험 감독과 학습 평가를 돕는 도구를 만듭니다.' : 'Tools for exam proctors and instructors.'}</p></div>
        <div class="footer-links"><div><strong>{lang === 'ko' ? '살펴보기' : 'Explore'}</strong>{(['app', 'research', 'institutions', 'journal'] as PageKey[]).map(key => <a href={path(lang, key)}>{t[key]}</a>)}</div><div><strong>{lang === 'ko' ? '함께하기' : 'Connect'}</strong><a href={path(lang, 'about')}>{t.about}</a><a href={path(lang, 'contact') + '?type=institution'}>{lang === 'ko' ? '기관 도입 문의' : 'Institutional inquiries'}</a><a href={path(lang, 'contact') + '?type=partnership'}>{lang === 'ko' ? '제휴 문의' : 'Partnerships'}</a><a href={path(lang, 'contact') + '?type=investment'}>{lang === 'ko' ? '투자 문의' : 'Investment'}</a></div></div>
        <div class="footer-contact"><span>{lang === 'ko' ? '기관 도입·제휴·투자 문의' : 'Institutional, partnership and investment inquiries'}</span><a href={`mailto:${EMAIL}`}>{EMAIL}<Icon name="arrow"/></a><button class="text-link" type="button" data-share><Icon name="share"/>{t.share}</button></div>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Smart Detector</span><a href={PRIVACY}>{t.privacy}</a><span>{lang === 'ko' ? 'Android 무료 제공 · iOS 개발 중' : 'Free on Android · iOS in development'}</span></div>
    </footer>
    {(page === 'home' || page === 'app') && <div class="mobile-install"><span>{lang === 'ko' ? 'Android에서 무료로 사용하세요.' : 'Free on Android'}</span><PlayButton lang={lang} placement="mobile-bar" small/></div>}
    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
    <script>import '../scripts/site';</script>
  </body>
</html>
