---
import Icon from './Icon.astro';
import type { Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
// The flow of app 0.13: three presses (`press`) and what the screen shows in between.
const steps = lang === 'ko' ? [
  { id: 'ready', tag: '버튼 1', press: true, label: '빈 강의실 측정', desc: '응시자가 들어오기 전에 누릅니다.', detail: '앱을 열면 누를 순서 세 가지가 화면에 적혀 있고, 아직 아무것도 수신하지 않습니다. 응시자가 들어오기 전에 ‘빈 강의실 측정’을 누릅니다.', alt: '파란 수신 대기 화면과 세 단계 사용 안내 화면' },
  { id: 'empty-room', tag: '측정 중', press: false, label: '90초 동안 기다리기', desc: '원래 있던 신호를 기준으로 남깁니다.', detail: '빈 강의실에 원래 있던 Wi-Fi와 Bluetooth 신호를 90초 동안 수신합니다. 남은 시간이 화면에서 줄어듭니다. 이 신호들이 기준이 되어, 이후에 새로 수신한 신호와 구분됩니다.', alt: '빈 강의실 측정 중 수신한 신호와 남은 시간을 표시하는 화면' },
  { id: 'baseline-ready', tag: '입실 중', press: false, label: '빈 강의실에 없던 신호', desc: '기준에 없던 신호만 따로 셉니다.', detail: '응시자가 들어오는 동안 빈 강의실에 없던 신호만 따로 셉니다. 응시자가 기기를 끄면 숫자가 내려갑니다. 남은 신호는 눌러서 찾으러 가거나, 허용 기기나 방 밖 신호로 남겨 둘 수 있습니다.', alt: '측정 완료 후 입실 중 빈 강의실에 없던 신호를 표시하는 화면' },
  { id: 'monitoring', tag: '버튼 2', press: true, label: '시험 중 감시 시작', desc: '새 신호를 수신하면 진동으로 알립니다.', detail: '시험이 시작될 때 누릅니다. 그 뒤로 새 신호를 수신하면 휴대폰이 두 번 진동하고 숫자판이 노랗게 바뀝니다. 앱 화면을 켜 둔 채 들고 있으면 화면을 계속 들여다보지 않아도 됩니다. 신호를 누르고 확인함·찾지 못함 같은 결과를 고르면 기록에 남습니다.', alt: '시험 중 새 신호 두 개와 감독관의 판단 상태를 표시하는 화면' },
  { id: 'paused', tag: '버튼 3', press: true, label: '시험 종료', desc: '끝나면 누릅니다. 보고서가 만들어집니다.', detail: '시험이 끝나면 ‘시험 종료’를 누릅니다. 수신을 멈추고 화면에 한 장짜리 보고서를 보여 줍니다. 자세한 기록은 PDF로 저장하거나 보낼 수 있습니다. 그림은 시험 도중 ‘시험 멈춤’을 누른 화면이며, 멈춘 시간은 보고서에 따로 남습니다.', alt: '시험 멈춤과 수신 중단, 시험 재개와 시험 종료 버튼을 표시하는 화면' },
] : [
  { id: 'ready', tag: 'Button 1', press: true, label: 'Measure the empty room', desc: 'Press it before candidates arrive.', detail: 'The standby screen lists the three presses in order, and the app is not receiving yet. Start the empty-room measurement before candidates enter.', alt: 'Blue standby screen with the three-step assessment workflow' },
  { id: 'empty-room', tag: 'Measuring', press: false, label: 'Wait 90 seconds', desc: 'Signals already in the room become the baseline.', detail: 'For 90 seconds the app receives the Wi-Fi and Bluetooth signals already present in the empty room, with the remaining time counting down on screen. They become the baseline that newly received signals are compared with.', alt: 'Empty-room measurement screen with received signals and remaining time' },
  { id: 'baseline-ready', tag: 'Arrival', press: false, label: 'Signals the empty room did not have', desc: 'Counted separately from the baseline.', detail: 'While candidates arrive, the app counts only the signals that were absent from the empty room. The count goes down when a candidate switches a device off. For the signals that remain, you can go and look for the device, or mark it as permitted or as coming from outside the room.', alt: 'Pre-exam screen separating signals absent from the room baseline' },
  { id: 'monitoring', tag: 'Button 2', press: true, label: 'Start exam monitoring', desc: 'The phone vibrates when it receives a new signal.', detail: 'Press it when the exam starts. When the app receives a new signal after that, the phone vibrates twice and the figure panel turns yellow. Keep the app open with the screen on, and you do not need to keep watching it. Tap the signal and record what you found, such as checked or not found.', alt: 'Monitoring screen with two new signals and proctor check statuses' },
  { id: 'paused', tag: 'Button 3', press: true, label: 'End the exam', desc: 'Press it at the end. The app creates the report.', detail: 'Press it when the exam is over. Reception stops and a one-page report appears on screen. The detailed record can be saved or sent as a PDF. The screen shown here is an exam that was paused partway through; paused time is recorded separately in the report.', alt: 'Paused exam screen showing no reception, with resume and end buttons' },
];
---
<div class="workflow" data-workflow>
  <div class="workflow-steps" aria-label={lang === 'ko' ? '앱 사용 순서' : 'App workflow'}>
    {steps.map(step => <a class="workflow-step" id={`tab-${step.id}`} href={`#step-${step.id}`} data-step><span class:list={['step-number', step.press && 'step-press']}>{step.tag}</span><span><strong>{step.label}</strong><span>{step.desc}</span></span><Icon name="arrow"/></a>)}
  </div>
  <div class="workflow-panels">{steps.map(step => <div class="workflow-panel" id={`step-${step.id}`} data-step-panel><div class="screen-mat"><a href={lang === 'ko' ? `/assets/screenshots/${step.id}.png` : `/assets/localized/en/${step.id}.webp`} target="_blank" rel="noopener" aria-label={lang === 'ko' ? `${step.alt} 원본 보기 (새 탭)` : `${step.alt}, open full size (new tab)`}><img class="app-screen" src={lang === 'ko' ? `/assets/screenshots/${step.id}.png` : `/assets/localized/en/${step.id}.webp`} alt={step.alt} width="780" height="1688" loading="lazy"/></a></div><p>{step.detail}</p></div>)}</div>
</div>
