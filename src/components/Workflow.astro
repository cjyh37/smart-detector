---
import Icon from './Icon.astro';
import type { Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const steps = lang === 'ko' ? [
  { id: 'ready', label: '사용 순서 확인', desc: '대기 화면에서 측정을 준비합니다.', detail: '대기 화면에서 빈 강의실 측정부터 시험 종료까지의 순서를 볼 수 있습니다. 측정을 시작하기 전에는 수신 대기 상태로 표시됩니다.', alt: '파란 수신 대기 화면과 세 단계 사용 안내 시안' },
  { id: 'empty-room', label: '빈 강의실 측정', desc: '입실 전 신호를 기준으로 남깁니다.', detail: '응시자가 입실하기 전에 주변 신호를 측정합니다. 원래 있던 Wi-Fi와 Bluetooth 신호를 알아두고, 이후 수신되는 신호와 비교할 기준으로 삼습니다.', alt: '빈 강의실 측정 중 수신한 신호와 남은 시간을 표시하는 시안' },
  { id: 'baseline-ready', label: '입실 후 신호 비교', desc: '빈 강의실에 없던 신호를 살펴봅니다.', detail: '빈 강의실에 없던 신호와 이미 수신하던 신호를 구분합니다. 기기의 이름이나 분류는 현장 확인을 위한 단서로 참고합니다.', alt: '측정 완료 후 입실 중 빈 강의실에 없던 신호를 표시하는 시안' },
  { id: 'monitoring', label: '시험 중 새 신호 확인', desc: '신호를 확인한 결과를 기록합니다.', detail: '시험 시작 이후 새로 수신된 신호를 살펴보고, 확인 대기·확인함·찾지 못함 등의 상태를 기록합니다. 새로운 신호 자체가 부정행위를 뜻하지는 않습니다.', alt: '시험 중 새 신호 두 개와 감독관의 판단 상태를 표시하는 시안' },
  { id: 'paused', label: '일시정지와 재개', desc: '수신을 멈춘 시간도 보고서에 남습니다.', detail: '시험을 멈추면 신호 수신도 중단됩니다. 보고서에 중단 시간을 남겨, 나중에 기록을 볼 때 어느 구간에서 수신하지 않았는지 알 수 있습니다.', alt: '시험 멈춤과 수신 중단, 시험 재개 버튼을 표시하는 시안' },
] : [
  { id: 'ready', label: 'Prepare to scan', desc: 'Check the steps on the standby screen.', detail: 'The standby screen shows the steps from measuring the empty room to ending the exam. It also shows that reception has not started yet.', alt: 'Blue standby design with the three-step assessment workflow, Korean interface' },
  { id: 'empty-room', label: 'Measure the empty room', desc: 'Establish a baseline before candidates arrive.', detail: 'Observe nearby signals before candidates enter. Existing Wi-Fi and Bluetooth signals provide a baseline for interpreting later observations.', alt: 'Empty-room measurement design with received signals and remaining time, Korean interface' },
  { id: 'baseline-ready', label: 'Compare signals after arrival', desc: 'Check signals absent from the room baseline.', detail: 'Separate signals absent from the empty-room baseline from those already observed. Device names and categories are clues for an on-site check.', alt: 'Pre-exam design separating signals absent from the room baseline, Korean interface' },
  { id: 'monitoring', label: 'Check new signals during the exam', desc: 'See pending checks and recorded findings.', detail: 'Review signals newly received after the start and record whether they are pending, checked or not found. A new signal alone does not establish misconduct.', alt: 'Monitoring design with two new signals and proctor check statuses, Korean interface' },
  { id: 'paused', label: 'Pause and resume', desc: 'Paused time appears in the report.', detail: 'Pausing the exam stops signal reception. The report records the pause so you can see which intervals have no reception data.', alt: 'Paused exam design showing no reception and a resume button, Korean interface' },
];
---
<div class="workflow" data-workflow>
  <div class="workflow-steps" aria-label={lang === 'ko' ? '앱 사용 순서' : 'App workflow'}>
    {steps.map((step, index) => <a class="workflow-step" id={`tab-${step.id}`} href={`#step-${step.id}`} data-step><span class="step-number">{String(index + 1).padStart(2, '0')}</span><span><strong>{step.label}</strong><span>{step.desc}</span></span><Icon name="arrow"/></a>)}
    <p class="workflow-note">{lang === 'ko' ? '앱 화면 시안과 예시 데이터입니다. 현재 배포 버전의 화면과 다를 수 있습니다.' : 'Interface designs with example data. The released app may look different. Its interface is in Korean.'}</p>
  </div>
  <div class="workflow-panels">{steps.map(step => <div class="workflow-panel" id={`step-${step.id}`} data-step-panel><div class="screen-mat"><a href={`/assets/screenshots/${step.id}.png`} target="_blank" rel="noopener" aria-label={lang === 'ko' ? `${step.alt} 원본 보기 (새 탭)` : `${step.alt}, open full size (new tab)`}><img class="app-screen" src={`/assets/screenshots/${step.id}.png`} alt={step.alt} width="780" height="1688" loading="lazy"/></a></div><p>{step.detail}</p></div>)}</div>
</div>
