---
import PlayButton from './PlayButton.astro';
import Icon from './Icon.astro';
import { labels, path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
---
<section class="install-section" id="download"><div class="container install-inner"><div><h2>{lang === 'ko' ? '다음 시험,\n앱으로 시작하세요.' : 'Start with the app.\nBe ready for the next exam.'}</h2><p>{lang === 'ko' ? '지금 사용할 수 있는 무료 Android 감독 보조도구.' : 'A free Android tool you can start using today.'}</p><PlayButton lang={lang} placement="install-section" light/><p class="install-meta">{lang === 'ko' ? 'Android 무료 제공 · iOS 개발 중' : 'Korean-language Android app · iOS in development'}</p></div><div class="install-side"><img src="/assets/play-qr.svg" alt={lang === 'ko' ? 'Google Play 앱 설치 페이지 QR 코드' : 'QR code for the Google Play app page'} width="142" height="142" loading="lazy"/><p>{lang === 'ko' ? '휴대폰 카메라로 스캔하세요.' : 'Scan with your phone camera.'}</p><a class="text-link" href={path(lang, 'app')}>{labels[lang].learn}<Icon name="arrow"/></a></div></div></section>
