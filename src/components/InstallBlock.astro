---
import PlayButton from './PlayButton.astro';
import Icon from './Icon.astro';
import { labels, path, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
---
<section class="install-section" id="download"><div class="container install-inner"><div><h2>{lang === 'ko' ? '무료로 설치하고\n시험 전에 사용해 보세요.' : 'Try the free app\nbefore your next exam'}</h2><p>{lang === 'ko' ? '가입 없이 바로 쓸 수 있습니다. 빈 강의실에서 90초 측정부터 해 보세요.' : 'No account needed. Start with a 90-second measurement in an empty room.'}</p><PlayButton lang={lang} placement="install-section" light/><p class="install-meta">{lang === 'ko' ? 'Android 12 이상 · 무료 · iOS 개발 중' : 'Android 12 or later · Free · Korean interface · iOS in development'}</p></div><div class="install-side"><img src="/assets/play-qr.svg" alt={lang === 'ko' ? 'Google Play 앱 설치 페이지 QR 코드' : 'QR code for the Google Play app page'} width="142" height="142" loading="lazy"/><p>{lang === 'ko' ? '휴대폰 카메라로 스캔하세요.' : 'Scan with your phone camera.'}</p><a class="text-link" href={path(lang, 'app')}>{labels[lang].learn}<Icon name="arrow"/></a></div></div></section>
