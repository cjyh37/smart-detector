---
import Icon from './Icon.astro';
import { path, PRIVACY, type Lang } from '../data/site';
const { lang, full = false } = Astro.props as { lang: Lang; full?: boolean };
// The first four are the ones shown on the home page.
const items = lang === 'ko' ? [
  ['모든 스마트안경·이어폰·카메라를 찾을 수 있나요?', '아닙니다. 휴대폰이 수신할 수 있는 Wi-Fi·Bluetooth 신호만 보여주며, 기기의 통신·연결 상태나 휴대폰 기종·운영체제에 따라 결과가 달라집니다. 신호를 내보내지 않는 기기는 잡히지 않습니다.'],
  ['신호가 나타나면 부정행위가 있었다는 뜻인가요?', '아닙니다. 신호만으로는 기기의 주인이나 좌석, 촬영·녹음 여부를 알 수 없어 반드시 현장에서 직접 확인해야 합니다. 반대로 신호가 없다고 해서 기기가 없는 것도 아닙니다.'],
  ['시험 중에 화면을 계속 봐야 하나요?', '아닙니다. 감시 시작 뒤 새 신호가 잡히면 휴대폰이 두 번 진동합니다. 앱 화면을 켜 둔 채 들고 있다가 진동이 오면 신호를 확인하고 점검 결과를 남기면 됩니다. 다른 앱을 열어도 수신은 이어지지만 진동은 스마트 디텍터 화면으로 돌아올 때 울립니다. 휴대폰 화면이 꺼지면 수신이 줄어들 수 있으며, 그 시간은 보고서에 따로 기록됩니다.'],
  ['수신한 신호와 기록이 외부로 전송되나요?', '전송되지 않습니다. 수신 신호와 확인 기록은 휴대폰 안에만 저장되며, 보고서도 직접 저장하거나 공유할 때만 외부로 전달됩니다. 가입 없이 오프라인에서도 쓸 수 있고, 온라인 상태에서는 앱 실행·사용 시간 같은 기본 사용 통계만 전송됩니다.'],
  ['무료인가요? iPhone에서도 쓸 수 있나요?', 'Android 12 이상 기기에서 Google Play를 통해 무료로 설치할 수 있습니다. iOS 버전은 현재 개발 중입니다.'],
  ['어떤 권한을 허용해야 하나요?', '주변 기기 권한과 위치 권한이 필요합니다. 위치 권한은 Android에서 Wi-Fi·Bluetooth 검색을 위해 요구하는 항목일 뿐이며, GPS 좌표를 읽거나 저장하지 않습니다. 시험 전에 권한을 허용하고 신호가 잘 잡히는지 먼저 확인해 주세요.'],
  ['전용 디바이스를 지금 도입할 수 있나요?', '아직 구상·연구 준비 단계라 판매 중인 기기는 없습니다. 성능과 가격, 출시 일정이 정해지면 안내하겠습니다. 필요한 기능 제안이나 연구 협력 문의는 언제든 환영합니다.'],
] : [
  ['Can it find all smart glasses, earphones and cameras?', 'No. It only shows Wi-Fi and Bluetooth signals your phone can receive. Results depend on the device’s protocol and pairing state, as well as your phone and OS. Devices emitting no receivable signal will not appear.'],
  ['Does a signal mean someone is cheating?', 'No. A signal alone never identifies the owner or seat, nor does it prove recording or cheating—always verify on site. Conversely, seeing no signal does not mean no device is present.'],
  ['Do I have to keep watching the screen during the exam?', 'No. Once monitoring starts, your phone vibrates twice when it receives a new signal. Hold the phone with the app screen on, check the signal when it vibrates and log what you found. Reception continues if you switch apps, though vibrations fire when you return to Smart Detector. Turning the phone screen off can reduce reception, and that time is noted separately in the report.'],
  ['Are the signals and records sent anywhere?', 'No. Received signals and check logs stay on your phone, and reports leave the device only when you save or share them yourself. No account is required and the app works offline; when online, it sends basic usage stats only, such as app opens and session duration.'],
  ['Is it free? Does it work on iPhone?', 'The Android app is free on Google Play for Android 12 or later (Korean interface; store availability varies by region). An iOS version is in development.'],
  ['Which permissions does the app need?', 'Nearby-devices and location permissions. Android requires location permission for Wi-Fi and Bluetooth scanning; the app does not read or store GPS coordinates. Grant the permissions and test signal reception before exam day.'],
  ['Can we purchase dedicated hardware now?', 'Not yet—hardware is in concept and research preparation, with no device on sale. We will share specs, pricing and timing once set. Feature requests and research inquiries are welcome anytime.'],
];
---
<section class="section" id="questions"><div class="container faq-layout"><div><h2>{lang === 'ko' ? '자주 묻는 질문' : 'Frequently asked questions'}</h2><a class="text-link" href={path(lang, 'contact') + '?type=support'}>{lang === 'ko' ? '다른 질문이 있나요?' : 'Have another question?'}<Icon name="arrow"/></a></div><div class="faq-list">{items.slice(0, full ? items.length : 4).map(([question, answer]) => <details><summary>{question}<Icon name="plus"/></summary><p>{answer}</p></details>)}<a class="text-link privacy-link" href={PRIVACY}>{lang === 'ko' ? '개인정보처리방침 보기' : 'Read our privacy policy'}<Icon name="external"/></a></div></div></section>
