---
import type { Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
const tabs = ko ? ['과정 기록', '기여와 점수', '구술 확인'] : ['Process record', 'Contribution & scoring', 'Oral check'];
const events = ko ? [
  ['학생 · 문제 정의', '반납이 쉬워야, 다시 쓰게 된다.', '교내 일회용 컵을 줄이는 과제에서 반납 동선과 참여 부담을 먼저 문제로 정의합니다.'],
  ['AI · 대안 제안', '보증금, 리워드 앱, 반납함 배치', 'AI가 제안한 대안을 비교할 출발점으로 남깁니다.'],
  ['학생 · 비판과 수정', '앱 설치도 새로운 장벽 아닐까?', '리워드 앱의 추가 부담을 지적하고, 기존 학생증과 반납 동선을 활용하는 안으로 수정합니다.'],
  ['학생 · 검증 계획', '반납함 위치를 바꿔 비교한다.', '위치에 따른 반납률을 비교하는 실험을 제안하고, 성공 여부를 판단할 기준을 정합니다.'],
] : [
  ['Student · Framing', 'Make returning a cup easy.', 'The student frames return routes and participation effort as key issues in reducing single-use cups on campus.'],
  ['AI · Alternatives', 'Deposits, a rewards app, collection points', 'AI-generated alternatives become a recorded starting point for comparison.'],
  ['Student · Critique & revision', 'Could installing an app create another barrier?', 'The student challenges the added effort and revises the idea around existing student IDs and return routes.'],
  ['Student · Validation plan', 'Compare collection-point locations.', 'The student proposes an experiment and defines how to judge whether the change works.'],
];
const scores = ko ? [
  ['문제 정의', '4 / 5', '참여 부담과 반납 동선을 핵심 조건으로 정리'],
  ['검토·개선', '4 / 5', 'AI 제안의 추가 장벽을 지적하고 대안 수정'],
  ['고유한 기여', '5 / 5', '위치 비교 실험과 성공 판단 기준을 직접 제안'],
] : [
  ['Problem framing', '4 / 5', 'Identifies participation effort and return routes as key conditions'],
  ['Critique & revision', '4 / 5', 'Challenges an AI suggestion and revises the approach'],
  ['Original contribution', '5 / 5', 'Proposes a location comparison and its success criteria'],
];
const questions = ko ? [
  ['선택의 이유', 'AI가 제안한 리워드 앱을 바꾼 이유는 무엇인가요?'],
  ['판단의 근거', '반납함 위치가 중요하다는 생각은 어디에서 나왔나요?'],
  ['이해의 전이', '위치를 바꿔도 반납률이 같다면 다음에는 무엇을 바꾸겠어요?'],
] : [
  ['Reasoning', 'Why did you change the AI’s suggestion of a rewards app?'],
  ['Evidence', 'What led you to focus on the collection-point location?'],
  ['Transfer', 'If changing the location made no difference, what would you change next?'],
];
---
<div class="assessment-demo" data-assessment-demo>
  <div class="assessment-toolbar"><strong>{ko ? '학습 과정 리포트' : 'Learning process report'}</strong><span>{ko ? '제품 콘셉트' : 'Product concept'}</span></div>
  <div class="assessment-assignment"><h3>{ko ? '교내 일회용 컵을 줄이는 방법' : 'Reducing single-use cups on campus'}</h3><p>{ko ? '예시 과제 · AI와 협업하는 문제해결 프로젝트' : 'Example assignment · A problem-solving project with AI'}</p></div>
  <div class="assessment-tabs" aria-label={ko ? '플랫폼 예시 화면' : 'Platform example views'}>{tabs.map((title, index) => <a href={`#assessment-panel-${index}`} id={`assessment-tab-${index}`} data-assessment-tab>{title}</a>)}</div>
  <div class="assessment-panel" id="assessment-panel-0" data-assessment-panel>
    <div class="assessment-record"><ol class="evidence-timeline">{events.map(([actor, title, body]) => <li><span class="evidence-actor">{actor}</span><h4>{title}</h4><p>{body}</p></li>)}</ol><aside class="contribution-note"><h4>{ko ? '이 학생이 더한 생각' : 'What this student contributed'}</h4><p>{ko ? '“더 큰 보상”에서 “더 쉬운 반납”으로 문제를 다시 바라보고, 실제로 비교할 실험까지 설계했습니다.' : 'The student reframed the problem from bigger rewards to easier returns, then designed a way to compare the idea in practice.'}</p><div class="evidence-link"><span>{ko ? '연결되는 근거' : 'Linked evidence'}</span><strong>{ko ? '수정 이유 · 대안 비교 · 검증 계획' : 'Revision rationale · Alternatives · Validation plan'}</strong></div></aside></div>
  </div>
  <div class="assessment-panel" id="assessment-panel-1" data-assessment-panel>
    <div class="score-intro"><h4>{ko ? '점수에, 근거를 연결합니다.' : 'Every score needs its evidence.'}</h4><p>{ko ? '교수자가 정한 루브릭으로 자동 점수 초안을 만들고, 각 항목에서 확인할 기록을 함께 보여주는 설계입니다.' : 'The concept applies instructor-defined rubrics to suggest scores and presents the records behind each criterion.'}</p></div>
    <table class="rubric-table"><caption class="sr-only">{ko ? '가상 과제의 루브릭 점수 예시' : 'Illustrative rubric scores for a fictional assignment'}</caption><thead><tr><th scope="col">{ko ? '평가 항목' : 'Criterion'}</th><th scope="col">{ko ? '초안' : 'Draft'}</th><th scope="col">{ko ? '기록에 남은 근거' : 'Evidence in the record'}</th></tr></thead><tbody>{scores.map(([criterion, score, evidence]) => <tr><th scope="row">{criterion}</th><td>{score}</td><td>{evidence}</td></tr>)}</tbody></table>
    <p class="assessment-panel-note">{ko ? '예시 점수 · 구술 확인과 교수자 검토를 거쳐 평가를 확정하는 흐름입니다.' : 'Example scores · The proposed workflow includes an oral check and instructor review before finalization.'}</p>
  </div>
  <div class="assessment-panel" id="assessment-panel-2" data-assessment-panel>
    <div class="score-intro"><h4>{ko ? '자신의 선택을, 직접 설명합니다.' : 'Explain your own choices.'}</h4><p>{ko ? '학생의 실제 수정과 판단에서 질문을 만들고, 짧은 구술로 이해와 고유한 기여를 확인합니다.' : 'Questions arise from the student’s recorded decisions and revisions. A brief oral check examines their understanding and contribution.'}</p></div>
    <ol class="oral-questions">{questions.map(([label, question], index) => <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{label}</strong><p>{question}</p></div></li>)}</ol>
    <p class="assessment-panel-note">{ko ? '설계 목표: 구술 답변을 과정 기록과 연결해 요약하고, 교수자가 확인할 지점을 정리합니다.' : 'Design goal: connect oral responses to the process record, summarize them and highlight points for instructor review.'}</p>
  </div>
  <p class="assessment-example-note">{ko ? '제품 흐름을 보여주는 설계 예시입니다. 과제·기록·점수는 모두 가상 데이터이며 실제 학생 평가 결과가 아닙니다.' : 'A design example of the intended workflow. The assignment, records and scores are fictional, not actual student assessment results.'}</p>
</div>
