---
import Icon from './Icon.astro';
import type { Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
const src = '/assets/reports/exam-report-example.png';
const notes = ko ? [
  { title: '측정 기준과 판단을 함께', body: '빈 강의실 측정과 시험 시작 시점을 구분하고, 새 신호를 확인했는지·찾지 못했는지 기록합니다. 신호가 보였다는 사실과 감독관의 판단을 나란히 읽을 수 있습니다.' },
  { title: '수신하지 못한 시간까지', body: '예시에서는 09:42:10부터 09:45:10까지 3분간 시험을 멈췄습니다. 이 구간을 ‘수신하지 않음’으로 남겨, 기록의 빈 구간도 확인할 수 있습니다.' },
  { title: '신호별로 시간·세기·메모', body: '처음과 마지막 수신 시각, 기기인식ID, 신호 방식, 수신 세기 변화, 현장에서 남긴 메모를 한 흐름으로 정리합니다.' },
] : [
  { title: 'Baselines alongside human findings', body: 'The empty-room measurement and exam start are recorded separately. New signals are marked as checked or not found, keeping observations distinct from the proctor’s findings.' },
  { title: 'Reception gaps stay visible', body: 'In this example, the exam was paused for three minutes, from 09:42:10 to 09:45:10. The interval is recorded as no reception, making the gap explicit.' },
  { title: 'A record for each signal', body: 'First and last reception times, device identifier, signal type, strength history and on-site notes are organized together for review.' },
];
---
<section class="section report-section" id="report" aria-labelledby="report-title">
  <div class="container">
    <div class="section-heading"><h2 id="report-title">{ko ? '시험이 끝나도,\n확인한 내용은 남습니다.' : 'After the exam,\nthe record remains.'}</h2><p>{ko ? '시험 무선 신호 보고서.\n무엇을 수신했고, 무엇을 확인했는지 한눈에.' : 'The exam wireless signal report.\nSee what was received and what was checked.'}</p></div>
    <div class="report-layout">
      <figure class="report-preview">
        <a class="report-sheet" href={src} target="_blank" rel="noopener" data-report-open aria-label={ko ? '시험 무선 신호 보고서 예시 확대 보기' : 'Enlarge the example exam signal report'}>
          <img src={src} width="1588" height="2246" loading="lazy" alt={ko ? '제3시험실 보고서 시안. 새 신호 2개, 확인 안 함 0개, 수신하지 못한 시간 3분. 기준과 판단, 수신 구간, 신호별 기록을 정리한 첫 쪽.' : 'Report design for Exam Room 3: two new signals, zero unchecked, three minutes without reception. Page one shows baselines, reception intervals and signal records in Korean.'}/>
          <span class="report-enlarge"><Icon name="expand"/>{ko ? '보고서 확대 보기' : 'Enlarge report'}</span>
        </a>
        <figcaption>{ko ? '보고서 디자인 시안 · 예시 데이터 · 전체 3쪽 중 제공된 1쪽' : 'Report design · Example data · Supplied page 1 of 3, in Korean'}</figcaption>
      </figure>
      <div class="report-explanation">
        <h3>{ko ? '숫자만이 아닌,\n확인 과정의 기록.' : 'More than counts.\nA record of the checks.'}</h3>
        <p class="report-lead">{ko ? '신호 목록만으로는 현장에서 무슨 일이 있었는지 알기 어렵습니다. 보고서는 관측 조건과 확인 결과를 함께 보여주는 형태로 구성했습니다.' : 'A signal list alone cannot explain what happened in the room. The report brings observation conditions and recorded findings into the same view.'}</p>
        <dl class="report-details">{notes.map(note => <div><dt>{note.title}</dt><dd>{note.body}</dd></div>)}</dl>
        <p class="report-context">{ko ? '이 보고서는 무선신호 관측과 현장 확인의 기록입니다. 부정행위 여부를 자동 판정하는 자료는 아닙니다.' : 'This report records wireless observations and on-site checks. It does not automatically establish misconduct.'}</p>
        <a class="text-link" href={src} download="smart-detector-report-example.png">{ko ? '보고서 예시 이미지 내려받기' : 'Download the example image'}<Icon name="down"/></a>
      </div>
    </div>
  </div>
</section>
<dialog class="report-dialog" data-report-dialog aria-labelledby="report-dialog-title">
  <div class="report-dialog-toolbar"><h2 id="report-dialog-title">{ko ? '보고서 예시 · 1쪽' : 'Example report · Page 1'}</h2><div><button class="button button-outline button-small" type="button" data-report-zoom aria-pressed="false">{ko ? '크게 보기' : 'Zoom in'}</button><button class="report-close" type="button" data-report-close autofocus aria-label={ko ? '보고서 닫기' : 'Close report'}><Icon name="close"/></button></div></div>
  <div class="report-dialog-scroll" data-report-scroll tabindex="0" aria-label={ko ? '확대 보고서. 스크롤해서 내용을 확인하세요.' : 'Enlarged report. Scroll to explore the contents.'}><img src={src} width="1588" height="2246" alt={ko ? '시험 무선 신호 보고서 예시 첫 쪽 원본' : 'Original first-page exam signal report example in Korean'} loading="lazy"/></div>
</dialog>
