---
import Icon from './Icon.astro';
import type { Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
const src = '/assets/reports/exam-report-example.png';
const notes = ko ? [
  { title: '측정 기준과 확인 결과', body: '빈 강의실과 시험 시작 전의 신호를 기준으로 남깁니다. 시험 중 새 신호는 감독관이 확인했는지, 기기를 찾지 못했는지 구분해 기록합니다.' },
  { title: '수신이 중단된 구간', body: '예시의 09:42:10~09:45:10은 시험을 멈춘 3분입니다. 이 시간은 ‘수신하지 않음’으로 표시됩니다.' },
  { title: '신호별로 시간·세기·메모', body: '각 신호의 처음·마지막 수신 시각과 기기인식ID, 신호 방식, 세기 변화를 보여줍니다. 감독관이 남긴 메모도 함께 볼 수 있습니다.' },
] : [
  { title: 'Baselines and check results', body: 'The report keeps the empty-room and pre-exam baselines separate. Each new signal has a status showing whether the proctor checked it or could not find the device.' },
  { title: 'Intervals without reception', body: 'In the example, the exam was paused from 09:42:10 to 09:45:10. Those three minutes are marked as having no reception.' },
  { title: 'A record for each signal', body: 'First and last reception times, device identifier, signal type, strength history and on-site notes are organized together for review.' },
];
---
<section class="section report-section" id="report" aria-labelledby="report-title">
  <div class="container">
    <div class="section-heading"><h2 id="report-title">{ko ? '시험 중 확인한 내용을\n보고서로 정리합니다.' : 'An exam report\nwith checks and signal records'}</h2><p>{ko ? '수신 시간과 신호의 변화, 감독관이 확인한 내용을 보여주는 보고서 예시입니다.' : 'This example shows reception times, changes in signals and the proctor’s recorded findings.'}</p></div>
    <div class="report-layout">
      <figure class="report-preview">
        <a class="report-sheet" href={src} target="_blank" rel="noopener" data-report-open aria-label={ko ? '시험 무선 신호 보고서 예시 확대 보기' : 'Enlarge the example exam signal report'}>
          <img src={src} width="1588" height="2246" loading="lazy" alt={ko ? '제3시험실 보고서 시안. 새 신호 2개, 확인 안 함 0개, 수신하지 못한 시간 3분. 기준과 판단, 수신 구간, 신호별 기록을 정리한 첫 쪽.' : 'Report design for Exam Room 3: two new signals, zero unchecked, three minutes without reception. Page one shows baselines, reception intervals and signal records in Korean.'}/>
          <span class="report-enlarge"><Icon name="expand"/>{ko ? '보고서 확대 보기' : 'Enlarge report'}</span>
        </a>
        <figcaption>{ko ? '보고서 시안 · 예시 데이터 · 3쪽 중 첫 쪽' : 'Report design · Example data · Page 1 of 3, in Korean'}</figcaption>
      </figure>
      <div class="report-explanation">
        <h3>{ko ? '신호를 받은 시간과\n감독관의 확인 기록' : 'Reception times\nand proctor findings'}</h3>
        <p class="report-lead">{ko ? '언제 신호를 받았고, 감독관이 무엇을 확인했는지 함께 볼 수 있습니다. 시험을 멈춰 신호를 받지 못한 시간도 기록에 남습니다.' : 'See when signals were received and what the proctor confirmed. The record also includes periods when the exam was paused and reception stopped.'}</p>
        <dl class="report-details">{notes.map(note => <div><dt>{note.title}</dt><dd>{note.body}</dd></div>)}</dl>
        <p class="report-context">{ko ? '보고서는 신호 수신과 현장 확인을 기록한 자료이며, 부정행위 여부를 자동으로 판정하지 않습니다.' : 'This report records wireless observations and on-site checks. It does not automatically establish misconduct.'}</p>
        <a class="text-link" href={src} download="smart-detector-report-example.png">{ko ? '보고서 예시 이미지 내려받기' : 'Download the example image'}<Icon name="down"/></a>
      </div>
    </div>
  </div>
</section>
<dialog class="report-dialog" data-report-dialog aria-labelledby="report-dialog-title">
  <div class="report-dialog-toolbar"><h2 id="report-dialog-title">{ko ? '보고서 예시 · 1쪽' : 'Example report · Page 1'}</h2><div><button class="button button-outline button-small" type="button" data-report-zoom aria-pressed="false">{ko ? '크게 보기' : 'Zoom in'}</button><button class="report-close" type="button" data-report-close autofocus aria-label={ko ? '보고서 닫기' : 'Close report'}><Icon name="close"/></button></div></div>
  <div class="report-dialog-scroll" data-report-scroll tabindex="0" aria-label={ko ? '확대 보고서. 스크롤해서 내용을 확인하세요.' : 'Enlarged report. Scroll to read the full page.'}><img src={src} width="1588" height="2246" alt={ko ? '시험 무선 신호 보고서 예시 첫 쪽 원본' : 'Original first-page exam signal report example in Korean'} loading="lazy"/></div>
</dialog>
