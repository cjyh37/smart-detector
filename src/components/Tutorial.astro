---
import Icon from './Icon.astro';
import type { Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
const watch = 'https://www.youtube.com/watch?v=O5zgEJZ8XXA';
const embed = `https://www.youtube-nocookie.com/embed/O5zgEJZ8XXA?rel=0&playsinline=1&hl=${lang}&autoplay=1`;
---
<section class="section tutorial-section" id="tutorial" aria-labelledby="tutorial-title">
  <div class="container">
    <div class="section-heading"><h2 id="tutorial-title">{ko ? '1분 사용법 영상' : 'One-minute tutorial'}</h2><p>{ko ? '첫 번째 버튼부터 보고서까지, 누르는 순서대로 보여줍니다.' : 'The video follows the buttons in the order you press them, from the first press to the report.'}</p></div>
    <div class="tutorial-player" data-tutorial data-embed-src={embed} data-video-title={ko ? '스마트 디텍터 사용법 — 시험감독 보조 앱 튜토리얼' : 'Smart Detector tutorial — Korean-language video'}>
      <a class="tutorial-cover" href={watch} target="_blank" rel="noopener" data-video-play>
        <img src="https://i.ytimg.com/vi/O5zgEJZ8XXA/maxresdefault.jpg" alt="" width="1280" height="720" loading="lazy"/>
        <span class="tutorial-play-label"><span class="tutorial-play-icon"><Icon name="play"/></span><strong>{ko ? '영상 재생' : 'Play tutorial'}</strong></span>
      </a>
    </div>
    <div class="tutorial-footer"><p>{ko ? '음성 해설 없이 화면 속 글로 설명하는 한국어 영상입니다.' : 'Korean on-screen text, no narration.'}</p><a class="text-link" href={watch} target="_blank" rel="noopener">{ko ? 'YouTube에서 보기' : 'Watch on YouTube'}<Icon name="external"/></a></div>
  </div>
</section>
