---
import Icon from './Icon.astro';
import type { Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const ko = lang === 'ko';
const watch = 'https://www.youtube.com/watch?v=O5zgEJZ8XXA';
const embed = `https://www.youtube-nocookie.com/embed/O5zgEJZ8XXA?rel=0&playsinline=1&hl=${lang}&autoplay=1`;
---
<section class="section tutorial-section" id="tutorial" aria-labelledby="tutorial-title">
  <div class="container">
    <div class="section-heading"><h2 id="tutorial-title">{ko ? '사용 방법을\n영상으로 확인하세요.' : 'See how to use it.\nWatch the walkthrough.'}</h2><p>{ko ? '처음 사용하기 전, 튜토리얼부터.\n이 페이지에서 바로 재생할 수 있습니다.' : 'Start with the tutorial.\nPlay it right here on the page.'}</p></div>
    <div class="tutorial-player" data-tutorial data-embed-src={embed} data-video-title={ko ? '스마트 디텍터 사용법 — 시험감독 보조 앱 튜토리얼' : 'Smart Detector tutorial — Korean-language video'}>
      <a class="tutorial-cover" href={watch} target="_blank" rel="noopener" data-video-play>
        <img src="https://i.ytimg.com/vi/O5zgEJZ8XXA/maxresdefault.jpg" alt="" width="1280" height="720" loading="lazy"/>
        <span class="tutorial-play-label"><span class="tutorial-play-icon"><Icon name="play"/></span><strong>{ko ? '튜토리얼 재생' : 'Play tutorial'}</strong></span>
      </a>
    </div>
    <div class="tutorial-footer"><p>{ko ? '한국어 영상 · 전체화면으로 볼 수 있습니다.' : 'Korean-language video · Full-screen playback available.'}</p><a class="text-link" href={watch} target="_blank" rel="noopener">{ko ? 'YouTube에서 보기' : 'Watch on YouTube'}<Icon name="external"/></a></div>
  </div>
</section>
