{
  "name": "smart-detector-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "dev": "node scripts/prepare-public.mjs && astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-public.mjs && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "test": "node --test scripts/contact.test.mjs && python -m unittest discover -s scripts -p test_*.py -v"
  },
  "dependencies": { "astro": "7.4.12" }
}
